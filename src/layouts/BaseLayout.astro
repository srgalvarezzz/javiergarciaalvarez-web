---
import '../styles/global.css';
import '../styles/tokens.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Javier García-Álvarez — Doctorando en Educación Tecnológica, UEx' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://javiergarciaalvarez.com');
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://javiergarciaalvarez.com');

const navLinks = [
  { href: '/',              label: 'Inicio'        },
  { href: '/sobre-mi',      label: 'Sobre mí'      },
  { href: '/investigacion', label: 'Investigación' },
  { href: '/recursos',      label: 'Recursos'      },
  { href: '/contacto',      label: 'Contacto'      },
];

const currentPath = Astro.url.pathname;

const isActive = (route: string): boolean =>
  route === '/' ? currentPath === '/' : currentPath.startsWith(route);
const isEnglish = currentPath.startsWith('/en');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Javier García-Álvarez</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Javier García-Álvarez" />
    <meta property="og:title" content={`${title} | Javier García-Álvarez`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Javier García-Álvarez`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FAFAF7" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Fase 1 rediseño: tipografías del nuevo sistema -->
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-screen bg-white text-slate-800 flex flex-col">

    <!-- Header (Fase 4) -->
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-logo" aria-label="Inicio">
          <span class="site-logo-first">javier </span><span class="site-logo-emphasis">garcía-álvarez</span>
        </a>

        <nav class="site-nav" aria-label="Navegación principal">
          <ul class="site-nav-list">
            {navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={['site-nav-link', { 'is-active': isActive(href) }]}
                  data-route={href}
                >{label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="site-header-actions">
          <div class="lang-toggle" role="group" aria-label="Selector de idioma">
            <a href="/" class="lang-toggle-option" data-lang="es" aria-current={!isEnglish ? 'true' : 'false'}>ES</a>
            <span class="lang-toggle-separator" aria-hidden="true">/</span>
            <a href="/en/" class="lang-toggle-option" data-lang="en" aria-current={isEnglish ? 'true' : 'false'}>EN</a>
          </div>
          <label for="mobile-menu-toggle" class="site-burger">
            <span class="sr-only">Menú</span>
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </label>
        </div>
      </div>

      <!-- Nav móvil (menú hamburguesa CSS conservado) -->
      <input type="checkbox" id="mobile-menu-toggle" class="site-nav-toggle" />
      <nav class="site-nav-mobile" aria-label="Navegación móvil">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={['site-nav-mobile-link', { 'is-active': isActive(href) }]}
          >{label}</a>
        ))}
      </nav>
    </header>

    <!-- Page content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <style>
      /* ── Header / Nav (Fase 4) ── usa tokens de tokens.css ── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--color-bg) 85%, transparent);
        border-bottom: 1px solid var(--color-border);
        backdrop-filter: saturate(180%) blur(8px);
        -webkit-backdrop-filter: saturate(180%) blur(8px);
      }

      .site-header-inner {
        max-width: var(--max-content);
        margin: 0 auto;
        padding: 1.25rem 1.5rem;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 2rem;
      }

      /* Logo */
      .site-logo {
        font-family: var(--font-body);
        font-size: var(--text-base);
        letter-spacing: -0.01em;
        color: var(--color-ink);
        text-decoration: none;
        white-space: nowrap;
        display: inline-flex;
        align-items: baseline;
        transition: opacity var(--transition-fast);
      }
      .site-logo:hover { opacity: 0.7; }
      .site-logo-first { font-weight: var(--weight-regular); color: var(--color-ink-soft); }
      .site-logo-emphasis { font-weight: var(--weight-semibold); color: var(--color-ink); }

      /* Nav desktop */
      .site-nav { justify-self: center; }
      .site-nav-list {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .site-nav-link {
        position: relative;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        color: var(--color-ink-muted);
        text-decoration: none;
        padding: 0.25rem 0;
        transition: color var(--transition-fast);
      }
      .site-nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 1.5px;
        background: var(--color-ink);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform var(--transition-base);
      }
      .site-nav-link:hover { color: var(--color-ink); }
      .site-nav-link:hover::after { transform: scaleX(1); }
      .site-nav-link.is-active { color: var(--color-ink); }
      .site-nav-link.is-active::after { transform: scaleX(1); }

      /* Acciones (lang toggle + burger) */
      .site-header-actions {
        justify-self: end;
        display: inline-flex;
        align-items: center;
        gap: 1rem;
      }

      .lang-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .lang-toggle-option {
        color: var(--color-ink-muted);
        text-decoration: none;
        padding: 0.25rem 0.4rem;
        border-radius: var(--radius-sm);
        transition: color var(--transition-fast), background var(--transition-fast);
      }
      .lang-toggle-option:hover { color: var(--color-ink); background: var(--color-surface-soft); }
      .lang-toggle-option[aria-current="true"] { color: var(--color-ink); font-weight: var(--weight-medium); }
      .lang-toggle-separator { color: var(--color-border-strong); user-select: none; }

      /* Burger (solo móvil) */
      .site-burger {
        display: none;
        cursor: pointer;
        color: var(--color-ink-soft);
        align-items: center;
        justify-content: center;
        padding: 0.25rem;
        transition: color var(--transition-fast);
      }
      .site-burger:hover { color: var(--color-ink); }

      /* Nav móvil */
      .site-nav-toggle { display: none; }
      .site-nav-mobile { display: none; }

      @media (max-width: 768px) {
        .site-header-inner { grid-template-columns: 1fr auto; gap: 1rem; }
        .site-nav { display: none; }
        .lang-toggle { display: none; }
        .site-burger { display: inline-flex; }

        .site-nav-mobile {
          flex-direction: column;
          border-top: 1px solid var(--color-border);
          padding: 0.25rem 1.5rem 0.75rem;
        }
        .site-nav-toggle:checked ~ .site-nav-mobile { display: flex; }

        .site-nav-mobile-link {
          font-family: var(--font-body);
          font-size: var(--text-sm);
          font-weight: var(--weight-medium);
          color: var(--color-ink-muted);
          text-decoration: none;
          padding: 0.7rem 0;
          border-bottom: 1px solid var(--color-border);
          transition: color var(--transition-fast);
        }
        .site-nav-mobile-link:last-child { border-bottom: none; }
        .site-nav-mobile-link:hover { color: var(--color-ink); }
        .site-nav-mobile-link.is-active { color: var(--color-ink); }
      }
    </style>

  </body>
</html>
