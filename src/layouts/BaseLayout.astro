---
import '../styles/global.css';
import '../styles/tokens.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Imagen de compartido, ruta desde la raíz. Por sección (tarea 5.9). */
  ogImage?: string;
  /** Objetos schema.org para el <head> (tarea 5.7). Uno o varios. */
  jsonLd?: object | object[];
}

const {
  title,
  description = 'Javier García-Álvarez — Doctorando en Educación Tecnológica, UEx',
  ogImage: rutaOgImage = '/og-image.png',
  jsonLd,
} = Astro.props;

const bloquesJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://javiergarciaalvarez.com');
const ogImage = new URL(rutaOgImage, Astro.site ?? 'https://javiergarciaalvarez.com');

// Astillas tiene una sola entrada y el nav la anunciaba como si fuera un blog
// activo. Sale del menú (escritorio y móvil); la ruta y el post siguen vivos y
// accesibles por URL directa, y el footer los enlaza.
// Para devolverla al nav cuando haya 4 entradas: poner esto a true. Nada más.
const ASTILLAS_EN_NAV: boolean = false;

const navLinks = [
  { href: '/',              label: 'Inicio'        },
  { href: '/sobre-mi',      label: 'Sobre mí'      },
  { href: '/investigacion', label: 'Investigación' },
  { href: '/recursos',      label: 'Recursos'      },
  ...(ASTILLAS_EN_NAV ? [{ href: '/astillas', label: 'Astillas' }] : []),
  { href: '/contacto',      label: 'Contacto'      },
];

const currentPath = Astro.url.pathname;

const isActive = (route: string): boolean =>
  route === '/' ? currentPath === '/' : currentPath.startsWith(route);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Javier García-Álvarez</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Javier García-Álvarez" />
    <meta property="og:title" content={`${title} | Javier García-Álvarez`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Javier García-Álvarez`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FAFAF7" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Las tres del sistema actual. Antes había además una hoja con Inter y
        Space Grotesk, del diseño anterior: tokens.css las pisaba enteras, así
        que era una petición bloqueante que no pintaba una sola letra. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Datos estructurados (Fase 5.7) -->
    {bloquesJsonLd.map((bloque) => (
      <script type="application/ld+json" set:html={JSON.stringify(bloque)} />
    ))}

    <!-- Feed de Astillas (Fase 5.4) -->
    <link rel="alternate" type="application/rss+xml" title="Astillas · Javier García-Álvarez" href="/rss.xml" />

    {/* Para páginas que necesitan algo propio en el head: por ahora, las
        tipografías del explorador de Minecraft. */}
    <slot name="head" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-screen flex flex-col">

    {/* Del <body> se cayeron bg-white y text-slate-800: tokens.css fija color
        y fondo aquí mismo sin capa, así que ganaba siempre. El fondo real es
        #FAFAF7, y esa discrepancia despistaba al calcular contrastes.
        Quedan solo las utilidades de layout, que sí son necesarias. */}

    {/* Primero en el DOM a propósito (tarea 6.4): quien navegue con teclado
        debe poder saltarse el menú antes de tabular por él entero. */}
    <a href="#contenido" class="skip-link">Saltar al contenido</a>

    <!-- Header (Fase 4) -->
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-logo" aria-label="Inicio">
          <span class="site-logo-first">javier </span><span class="site-logo-emphasis">garcía-álvarez</span>
        </a>

        <nav class="site-nav" aria-label="Navegación principal">
          <ul class="site-nav-list">
            {navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={['site-nav-link', { 'is-active': isActive(href) }]}
                  data-route={href}
                >{label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="site-header-actions">
          {/* Era un <label> gobernando un checkbox con display:none: ninguno de
              los dos recibe foco, así que con teclado el menú no se podía abrir
              y a 375 px no había forma de salir de la página. Ahora es un botón
              de verdad, que enfoca y responde a Enter y Espacio de serie. */}
          <button
            type="button"
            class="site-burger"
            aria-expanded="false"
            aria-controls="nav-movil"
            data-burger
          >
            <span class="sr-only">Menú</span>
            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>

      {/* Sin JS el menú se queda desplegado, que es utilizable. Es el script
          quien lo cierra al arrancar y quien lo convierte en desplegable. */}
      <nav id="nav-movil" class="site-nav-mobile" aria-label="Navegación móvil">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={['site-nav-mobile-link', { 'is-active': isActive(href) }]}
          >{label}</a>
        ))}
      </nav>
    </header>

    <script>
      const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
      const navMovil = document.querySelector<HTMLElement>('#nav-movil');

      if (burger && navMovil) {
        const abrir = (valor: boolean) => {
          burger.setAttribute('aria-expanded', String(valor));
          navMovil.dataset.abierto = String(valor);
        };

        abrir(false);
        burger.addEventListener('click', () => {
          abrir(burger.getAttribute('aria-expanded') !== 'true');
        });

        // Escape cierra y devuelve el foco al botón, para no dejar al teclado
        // dentro de un menú que ya no se ve.
        navMovil.addEventListener('keydown', (evento) => {
          if (evento.key === 'Escape') {
            abrir(false);
            burger.focus();
          }
        });
      }
    </script>

    <!-- Page content -->
    <main id="contenido" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <style>
      /* ── Saltar al contenido (Fase 6.4) ──
         Fuera de pantalla, no display:none: lo segundo lo sacaría del orden
         de tabulación y no habría nada que enfocar. */
      .skip-link {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 100;
        transform: translateY(-120%);
        background: var(--color-ink);
        color: var(--color-bg);
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        padding: 0.75rem 1.25rem;
        border-radius: 0 0 var(--radius-md) 0;
        text-decoration: none;
        transition: transform var(--transition-fast);
      }
      .skip-link:focus {
        transform: translateY(0);
        color: var(--color-bg);
      }
      @media (prefers-reduced-motion: reduce) {
        .skip-link { transition: none; }
      }

      /* El foco programático de <main> no debe dibujar un contorno alrededor
         de la página entera al llegar desde el enlace de salto. */
      main:focus { outline: none; }

      /* ── Header / Nav (Fase 4) ── usa tokens de tokens.css ── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--color-bg) 85%, transparent);
        border-bottom: 1px solid var(--color-border);
        backdrop-filter: saturate(180%) blur(8px);
        -webkit-backdrop-filter: saturate(180%) blur(8px);
      }

      .site-header-inner {
        max-width: var(--max-content);
        margin: 0 auto;
        padding: 1.25rem 1.5rem;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 2rem;
      }

      /* Logo */
      .site-logo {
        font-family: var(--font-body);
        font-size: var(--text-base);
        letter-spacing: -0.01em;
        color: var(--color-ink);
        text-decoration: none;
        white-space: nowrap;
        display: inline-flex;
        align-items: baseline;
        transition: opacity var(--transition-fast);
      }
      .site-logo:hover { opacity: 0.7; }
      .site-logo-first { font-weight: var(--weight-regular); color: var(--color-ink-soft); }
      .site-logo-emphasis { font-weight: var(--weight-semibold); color: var(--color-ink); }

      /* Nav desktop */
      .site-nav { justify-self: center; }
      .site-nav-list {
        display: flex;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .site-nav-link {
        position: relative;
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        color: var(--color-ink-muted);
        text-decoration: none;
        padding: 0.25rem 0;
        transition: color var(--transition-fast);
      }
      .site-nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 1.5px;
        background: var(--color-ink);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform var(--transition-base);
      }
      .site-nav-link:hover { color: var(--color-ink); }
      .site-nav-link:hover::after { transform: scaleX(1); }
      .site-nav-link.is-active { color: var(--color-ink); }
      .site-nav-link.is-active::after { transform: scaleX(1); }

      /* Acciones (burger) */
      .site-header-actions {
        justify-self: end;
        display: inline-flex;
        align-items: center;
        gap: 1rem;
      }

      /* Burger (solo móvil) */
      .site-burger {
        display: none;
        cursor: pointer;
        color: var(--color-ink-soft);
        align-items: center;
        justify-content: center;
        padding: 0.25rem;
        transition: color var(--transition-fast);
      }
      .site-burger:hover { color: var(--color-ink); }

      /* Nav móvil: en escritorio nunca se pinta. */
      .site-nav-mobile { display: none; }

      @media (max-width: 768px) {
        .site-header-inner { grid-template-columns: 1fr auto; gap: 1rem; }
        .site-nav { display: none; }
        .site-burger { display: inline-flex; }

        /* Desplegado por defecto; el script lo cierra marcando data-abierto.
           Así, sin JS, el menú sigue siendo navegable. */
        .site-nav-mobile {
          display: flex;
          flex-direction: column;
          border-top: 1px solid var(--color-border);
          padding: 0.25rem 1.5rem 0.75rem;
        }
        .site-nav-mobile[data-abierto='false'] { display: none; }

        .site-nav-mobile-link {
          font-family: var(--font-body);
          font-size: var(--text-sm);
          font-weight: var(--weight-medium);
          color: var(--color-ink-muted);
          text-decoration: none;
          padding: 0.7rem 0;
          border-bottom: 1px solid var(--color-border);
          transition: color var(--transition-fast);
        }
        .site-nav-mobile-link:last-child { border-bottom: none; }
        .site-nav-mobile-link:hover { color: var(--color-ink); }
        .site-nav-mobile-link.is-active { color: var(--color-ink); }
      }
    </style>

  </body>
</html>
