---
import VoiceMarker from './VoiceMarker.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-left">
      <a href="mailto:alvarez@unex.es" class="site-footer-email">alvarez@unex.es</a>
      {/* Única entrada al blog mientras Astillas esté fuera del nav (tarea 3.1). */}
      <a href="/astillas" class="site-footer-link">Astillas</a>
      <a href="/rss.xml" class="site-footer-link" aria-label="Feed RSS de Astillas">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 012.18-2.18M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"/>
        </svg>
        RSS
      </a>
    </div>

    <div class="site-footer-right">
      <a
        href="https://orcid.org/0009-0002-2876-2683"
        class="site-footer-link"
        target="_blank"
        rel="me noopener noreferrer"
        aria-label="Perfil de ORCID"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.6 0 12 0zM7.4 17.5H5.7V7.6h1.7v9.9zM6.5 6.5c-.6 0-1-.4-1-1s.4-1 1-1 1 .4 1 1-.4 1-1 1zm12 11h-1.7v-4.8c0-1.2 0-2.7-1.6-2.7-1.7 0-1.9 1.3-1.9 2.6v4.9h-1.7V7.6h1.6v1.3h.1c.2-.4.8-1.4 2.3-1.4 2.4 0 2.9 1.6 2.9 3.7v6.3z"/>
        </svg>
        ORCID
      </a>

      <a
        href="https://scholar.google.es/citations?user=mYf-JyQAAAAJ&hl=es"
        class="site-footer-link"
        target="_blank"
        rel="me noopener noreferrer"
        aria-label="Perfil de Google Scholar"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
        </svg>
        Scholar
      </a>
    </div>
  </div>

  <div class="site-footer-bottom">
    <span class="site-footer-marker"><VoiceMarker size={20} /></span>
    <p class="site-footer-credit">
      © <time datetime={String(year)}>{year}</time> Javier García-Álvarez · Contenido bajo
      <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC-BY 4.0</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-section);
    padding: 2.5rem 1.5rem 2rem;
    background: var(--color-bg);
  }

  .site-footer-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .site-footer-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .site-footer-email {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .site-footer-email:hover { color: var(--color-accent); }

  .site-footer-right { display: flex; gap: 1.5rem; }

  .site-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .site-footer-link:hover { color: var(--color-ink); }
  .site-footer-link svg { flex-shrink: 0; }

  .site-footer-bottom {
    max-width: var(--max-content);
    margin: 1.5rem auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .site-footer-marker {
    display: inline-flex;
    opacity: 0.35;
  }

  .site-footer-credit {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
  .site-footer-credit a {
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 2px;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }
  .site-footer-credit a:hover { color: var(--color-ink); text-decoration-color: var(--color-ink); }

  @media (max-width: 640px) {
    .site-footer-inner { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .site-footer-right { gap: 1rem; }
  }
</style>
