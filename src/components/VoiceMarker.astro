---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={`voice-marker ${className}`}
>
  <!-- Triángulo asimétrico de tres nodos -->
  <line x1="6" y1="8" x2="26" y2="14" />
  <line x1="26" y1="14" x2="12" y2="26" />
  <line x1="12" y1="26" x2="6" y2="8" />

  <!-- Nodos: dos círculos pequeños llenos -->
  <circle cx="6" cy="8" r="2" fill="currentColor" stroke="none" />
  <circle cx="12" cy="26" r="2" fill="currentColor" stroke="none" />

  <!-- Tercer nodo: cuadrado (asimetría intencional) -->
  <rect x="24" y="12" width="4" height="4" fill="currentColor" stroke="none" />
</svg>

<style>
  .voice-marker {
    color: var(--color-warm);
    display: inline-block;
    flex-shrink: 0;
  }
</style>
