---
import BaseLayout from '../../layouts/BaseLayout.astro';
import recursosData from '../../data/recursos.json';

/**
 * Página del recurso "Calculadora de baremos" (tarea 5.3).
 *
 * Ya no es una maqueta: la herramienta está publicada en el dominio, en
 * public/calculadora-pdi-uex/. Esta página la presenta, acota para qué sirve
 * y para qué no, y da la entrada.
 *
 * La calculadora es una página autónoma y no un componente Astro a propósito:
 * trae sus propios estilos y su propia cabecera, y meterla dentro del layout
 * del sitio duplicaría encabezados y arriesgaría choques de CSS.
 */

const recurso = recursosData.find((r) => r.id === 'calculadora-baremos')!;

const CALCULADORA = '/calculadora-pdi-uex/';

// Tutorial en Notion, anterior a la herramienta y conservado como apoyo.
const NOTION = 'https://www.notion.so/Tutorial-herramientas-de-c-lculo-2c0334b437154f7f9abcc2d82c1abd59';

// Cada figura se baremá con una norma distinta, y la calculadora lo dice en
// su propia barra lateral. La ficha las separa en vez de citar solo una.
const ficha = [
  { campo: 'Universidad', valor: 'Universidad de Extremadura' },
  { campo: 'Figuras', valor: 'Ayudante Doctor y Sustituto/a' },
  {
    campo: 'Baremo de Ayudante Doctor',
    valor: 'Resolución de 18/08/2025 del Rector (concurso C2), DOE núm. 164 de 26/08/2025',
  },
  {
    campo: 'Baremo de Sustituto/a',
    valor: 'Normativa de Contratación de la UEx, Anexo I',
  },
  { campo: 'Apartados', valor: 'Académico, cargos, docente, investigador y profesional' },
];
---

<BaseLayout
  title="Calculadora de baremos"
  description="Calculadora de baremos universitarios de Javier García-Álvarez para convocatorias predoctorales españolas. Página del recurso."
  ogImage="/og-recursos.png"
>
  <div class="recurso-page">

    <a href="/recursos" class="volver">← Recursos</a>

    <header class="page-header">
      <p class="eyebrow">Herramienta</p>
      <h1 class="page-title">{recurso.titulo}</h1>
      <p class="page-lead">{recurso.descripcion}</p>
    </header>

    <div class="aviso" role="note">
      <p>
        <strong>Sirve solo para la Universidad de Extremadura.</strong> Cada universidad
        publica sus propios baremos, con apartados y ponderaciones distintas. Aplicar
        estos números a otra convocatoria da un resultado equivocado.
      </p>
    </div>

    <section class="acceso">
      <a href={CALCULADORA} class="btn-primary">Abrir la calculadora</a>
      <p class="acceso-nota">
        Funciona entera en tu navegador: lo que escribes no se envía a ningún sitio.
        Puedes guardar tus datos en un archivo y recuperarlos después.
      </p>
    </section>

    <section class="ficha-seccion" aria-labelledby="ficha-titulo">
      <h2 id="ficha-titulo" class="subsection-title">Qué cubre</h2>
      <dl class="ficha">
        {ficha.map(({ campo, valor }) => (
          <div>
            <dt>{campo}</dt>
            <dd>{valor}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="salida">
      <h2 class="subsection-title">Otra universidad, dudas, errores</h2>
      <p class="salida-texto">
        Si te vendría bien una equivalente para tu convocatoria, escríbeme: haría falta
        el texto con el baremo detallado. Y si encuentras un error en los cálculos,
        dímelo — es la clase de fallo que conviene corregir rápido.
      </p>
      <div class="salida-acciones">
        <a
          href={`mailto:alvarez@unex.es?subject=${encodeURIComponent('Calculadora de baremos para otra universidad')}`}
          class="btn-primary"
        >
          Escribir sobre otra universidad
        </a>
        <a
          href={`mailto:alvarez@unex.es?subject=${encodeURIComponent(`Feedback: ${recurso.titulo}`)}`}
          class="link-arrow"
        >
          Avisar de un error
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="salida-nota">
        Hay además un <a href={NOTION} target="_blank" rel="noopener noreferrer">tutorial en
        Notion</a> sobre las herramientas de cálculo, anterior a esta calculadora.
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  .recurso-page {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  .volver {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color var(--transition-fast);
  }
  .volver:hover { color: var(--color-ink); }

  .page-header { margin-bottom: 2.5rem; max-width: 42rem; }
  .page-header .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
  }
  .page-lead {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  /* Aviso de maqueta: tiene que verse, o la página engaña. */
  .aviso {
    background: var(--color-warm-soft);
    border-left: 3px solid var(--color-warm);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: 1.25rem 1.5rem;
    max-width: 42rem;
    margin-bottom: calc(var(--space-section) * 0.5);
  }
  .aviso p {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin: 0;
  }
  .aviso strong { color: var(--color-ink); font-weight: var(--weight-semibold); }

  .subsection-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .acceso {
    margin-bottom: calc(var(--space-section) * 0.5);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .acceso-nota {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 40rem;
  }

  /* Ficha: mismo patrón que la de DIDACT.IA y la afiliación de /contacto */
  .ficha-seccion { margin-bottom: calc(var(--space-section) * 0.5); }
  .ficha {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 3rem;
    margin: 0;
    max-width: 46rem;
  }
  .ficha div { display: flex; flex-direction: column; gap: 0.25rem; }
  .ficha dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .ficha dd {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    margin: 0;
  }

  .salida-nota {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    max-width: 40rem;
  }
  .salida-nota a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 2px; }

  .salida-texto {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 36rem;
    margin-bottom: 1.5rem;
  }
  .salida-acciones {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: white; }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    transition: gap var(--transition-base), color var(--transition-fast);
  }
  .link-arrow:hover { color: var(--color-accent); gap: 0.7rem; }

  @media (max-width: 640px) {
    .ficha { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
