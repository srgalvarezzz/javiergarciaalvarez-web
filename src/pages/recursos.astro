---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import recursosData from '../data/recursos.json';
import { ultimaActualizacion } from '../utils/fechas';
import { dataset } from '../utils/jsonld';

// Solo lo publicado llega a la vista. Para reactivar un recurso basta con
// quitar (o poner a true) su "published" en src/data/recursos.json: vuelve
// a la lista y los contadores se recalculan solos.
const recursos = recursosData.filter((r) => r.published !== false);

// ── Filtros (contadores dinámicos en server-side) ──
const filtros = [
  { key: 'all', label: 'Todos' },
  { key: 'dataset', label: 'Datasets' },
  { key: 'tool', label: 'Herramientas' },
  { key: 'map', label: 'Mapas' },
  { key: 'template', label: 'Plantillas' },
];
const countFor = (k: string) => (k === 'all' ? recursos.length : recursos.filter((r) => r.type === k).length);
const chips = filtros.filter((f) => f.key === 'all' || countFor(f.key) > 0);

// Misma fuente que el chip "Todos": los dos números no pueden divergir.
const disponibles = countFor('all');

// Del máximo de lo publicado, nunca escrita a mano (tarea 3.3). Los recursos
// ocultos no cuentan: no se ven, así que no pueden justificar la fecha.
const actualizado = ultimaActualizacion(recursos);

// Solo los recursos con DOI: sin identificador persistente no hay Dataset
// que declarar, y hoy eso deja fuera al mapa y a la calculadora (tarea 5.7).
const datosEstructurados = recursos.filter((r) => r.doi).map(dataset);

// ── Feedback por recurso ──
// Estos enlaces apuntaban a /contacto?recurso=… dando por hecho que allí había
// un formulario que leyera el parámetro. No lo hay: /contacto son enlaces y una
// tabla de afiliación, así que el parámetro se descartaba en silencio y el
// visitante llegaba a una página que no le preguntaba nada.
//
// Parche: abrir el correo con el asunto ya puesto. Cumple la intención original
// sin construir backend.
//
// NOTA INTERNA (tarea 3.4, pendiente). Esto no cierra el asunto, lo aplaza.
// Construir el formulario de verdad obliga a elegir backend —Astro Actions con
// prerender = false sobre el Worker de Cloudflare, o un servicio externo— y es
// la tarea más grande que queda en la lista. Cuando se retome, este helper es
// el único punto que hay que cambiar en /recursos.
//
// Se usa mailto: a propósito, no el deeplink de Outlook que emplea /contacto:
// aquí el destinatario es un visitante cualquiera, que debe abrir su propio
// cliente de correo y no un login de Office 365. Ver el resumen del PR.
const CONTACTO_EMAIL = 'alvarez@unex.es';
const feedbackHref = (titulo: string) =>
  `mailto:${CONTACTO_EMAIL}?subject=${encodeURIComponent(`Feedback: ${titulo}`)}`;

// ── Generación dinámica de citas a partir de los metadatos ──
const TIPO_APA: Record<string, string> = { dataset: 'Conjunto de datos', tool: 'Herramienta', template: 'Plantilla' };
const RIS_TY: Record<string, string> = { dataset: 'DATA', tool: 'COMP', template: 'GEN' };
const BIB_TYPE: Record<string, string> = { dataset: 'dataset', tool: 'misc', template: 'misc' };

function buildCitations(r: any) {
  if (r.status === 'upcoming') return null;
  // Recursos sin DOI ni editor (p. ej. el mapa) no son citables.
  if (!r.doi && !r.editor) return null;
  const url = r.doi ? `https://doi.org/${r.doi}` : (r.citeUrl || r.accion?.url);
  const versionApa = r.version ? ` (Versión ${r.version})` : '';
  const tipoApa = TIPO_APA[r.type] ?? 'Recurso';
  const fuenteApa = r.doi ? `Zenodo. https://doi.org/${r.doi}` : (r.editor ? `${r.editor}.` : '');
  const apa = `${r.autorApa} (${r.anio}). ${r.titulo}${versionApa} [${tipoApa}]. ${fuenteApa}`.trim();

  const bibtex = [
    `@${BIB_TYPE[r.type] ?? 'misc'}{${r.bibtexKey},`,
    `  author    = {${r.autorBibtex}},`,
    `  title     = {${r.titulo}},`,
    r.mes ? `  month     = ${r.mes},` : null,
    `  year      = {${r.anio}},`,
    r.editor ? `  publisher = {${r.editor}},` : null,
    r.version ? `  version   = {${r.version}},` : null,
    r.doi ? `  doi       = {${r.doi}},` : null,
    `  url       = {${url}}`,
    `}`,
  ].filter(Boolean).join('\n');

  const ris = [
    `TY  - ${RIS_TY[r.type] ?? 'GEN'}`,
    `AU  - ${r.autorBibtex}`,
    `TI  - ${r.titulo}`,
    `PY  - ${r.anio}`,
    r.publicadoISO ? `DA  - ${r.publicadoISO.replace('-', '/')}` : null,
    r.editor ? `PB  - ${r.editor}` : null,
    r.doi ? `DO  - ${r.doi}` : null,
    `UR  - ${url}`,
    `ER  - `,
  ].filter(Boolean).join('\n');

  return { apa, bibtex, ris };
}

const cards = recursos.map((r) => ({ ...r, cites: buildCitations(r) }));
---

<BaseLayout
  title="Recursos"
  description="Recursos abiertos, datasets y herramientas de Javier García-Álvarez para docentes e investigadores en educación y tecnología educativa."
  jsonLd={datosEstructurados}
>
  <div class="resources-page">

    <header class="page-header">
      <p class="eyebrow">03 / Recursos</p>
      <h1 class="page-title">Recursos abiertos</h1>
      <p class="page-lead">
        Lo que produzco mientras investigo, en abierto. Si te resulta útil, úsalo y cítame. Si encuentras un error, dímelo.
      </p>
    </header>

    <div class="resources-toolbar">
      <div class="filter-chips" role="group" aria-label="Filtrar recursos por tipo">
        {chips.map((f) => (
          <button type="button" class:list={['filter-chip', { 'is-active': f.key === 'all' }]} data-filter={f.key}>
            {f.label}
            <span class="filter-chip-count">{countFor(f.key)}</span>
          </button>
        ))}
      </div>
      <p class="resources-meta">
        <span>{disponibles}</span> recursos · en abierto
      </p>
    </div>

    <ul class="resources-list">
      {cards.map((r) => (
        <li class="resource-card" data-type={r.type}>
          <div class="resource-card-header">
            <div class="resource-card-type">
              <span class="resource-card-icon" aria-hidden="true"><Icon name={r.icon} size={16} /></span>
              <span class="resource-card-type-label">{r.tipo}</span>
            </div>
            <span class:list={['status-pill', `status-${r.status}`]}>
              <span class="status-dot" aria-hidden="true"></span>
              {r.estado}
            </span>
          </div>

          <h2 class="resource-card-title">{r.titulo}</h2>

          {r.doi && (
            <p class="resource-card-doi">
              <span class="resource-card-doi-label">DOI</span>
              <code>{r.doi}</code>
              <button type="button" class="copy-btn" data-copy={r.doi} aria-label="Copiar DOI">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                  <rect x="9" y="9" width="13" height="13" rx="2" />
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
                </svg>
              </button>
            </p>
          )}

          <p class="resource-card-body">{r.descripcion}</p>

          {(r.publicado || r.version || r.licencia) && (
            <dl class="resource-card-metadata">
              {r.publicado && (
                <div><dt>Publicado</dt><dd>{r.publicado}</dd></div>
              )}
              {r.version && (
                <div><dt>Versión</dt><dd>{r.version}</dd></div>
              )}
              {r.licencia && (
                <div><dt>Licencia</dt><dd>{r.licencia}</dd></div>
              )}
            </dl>
          )}

          <div class="resource-card-actions">
            {r.status === 'upcoming' ? (
              <a href={r.accion.url} class="btn-secondary">{r.accion.label} →</a>
            ) : (
              <a
                href={r.accion.url}
                class="btn-primary"
                target={r.accion.external ? '_blank' : undefined}
                rel={r.accion.external ? 'noopener noreferrer' : undefined}
              >
                {r.accion.label}
                {r.accion.external && (
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                    <path d="M7 17L17 7M17 7H8M17 7V16" />
                  </svg>
                )}
              </a>
            )}

            {r.cites && (
              <button type="button" class="btn-secondary" data-toggle-cite aria-expanded="false" aria-controls={`cite-panel-${r.id}`}>
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                  <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z" />
                  <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z" />
                </svg>
                Cómo citar
              </button>
            )}

            {r.status !== 'upcoming' && (
              <a href={feedbackHref(r.titulo)} class="resource-card-feedback">Feedback</a>
            )}
          </div>

          {r.cites && (
            <div class="cite-panel" id={`cite-panel-${r.id}`} hidden>
              {([
                { name: 'APA 7', key: 'apa', text: r.cites.apa },
                { name: 'BibTeX', key: 'bibtex', text: r.cites.bibtex },
                { name: 'RIS', key: 'ris', text: r.cites.ris },
              ]).map((fmt) => (
                <div class="cite-format">
                  <div class="cite-format-header">
                    <span class="cite-format-name">{fmt.name}</span>
                    <button type="button" class="copy-btn-large" data-copy-target={`cite-${fmt.key}-${r.id}`}>Copiar</button>
                  </div>
                  <pre id={`cite-${fmt.key}-${r.id}`} class="cite-format-text">{fmt.text}</pre>
                </div>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>

    <div class="resources-empty" hidden>
      <p>No hay recursos de este tipo todavía.</p>
    </div>

    {actualizado && (
      <p class="page-updated">Última actualización: {actualizado}</p>
    )}

  </div>
</BaseLayout>

<script>
  // A) Filtros por tipo
  const filterChips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const resourceCards = document.querySelectorAll<HTMLLIElement>('.resource-card');
  const emptyState = document.querySelector<HTMLElement>('.resources-empty');

  filterChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      filterChips.forEach((c) => c.classList.toggle('is-active', c === chip));

      let visible = 0;
      resourceCards.forEach((card) => {
        const show = filter === 'all' || card.dataset.type === filter;
        card.hidden = !show;
        if (show) visible++;
      });

      if (emptyState) emptyState.hidden = visible > 0;
    });
  });

  // B) Desplegar / colapsar panel de citas
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-cite]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panelId = btn.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;
      const isOpen = !panel.hidden;
      panel.hidden = isOpen;
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  // C) Copiar al portapapeles — texto directo (DOI)
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add('is-copied');
        setTimeout(() => btn.classList.remove('is-copied'), 1500);
      } catch (e) {
        console.error('Copy failed', e);
      }
    });
  });

  // C) Copiar al portapapeles — contenido de un elemento (citas)
  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.copyTarget;
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;
      try {
        await navigator.clipboard.writeText((target.textContent ?? '').trim());
        const original = btn.textContent;
        btn.textContent = 'Copiado';
        btn.classList.add('is-copied');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('is-copied');
        }, 1500);
      } catch (e) {
        console.error('Copy failed', e);
      }
    });
  });
</script>

<style>
  /* ── Página Recursos (Fase 6) ── usa tokens de tokens.css ── */
  .resources-page {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  /* Header de página */
  .page-header { margin-bottom: 3rem; max-width: 42rem; }
  .page-header .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
  }
  .page-lead {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  /* Toolbar */
  .resources-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .filter-chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    background: transparent;
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }
  .filter-chip:hover { border-color: var(--color-border-strong); color: var(--color-ink); }
  .filter-chip.is-active { background: var(--color-ink); color: var(--color-bg); border-color: var(--color-ink); }
  .filter-chip-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.7;
    padding: 0.1rem 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 99px;
  }
  .filter-chip:not(.is-active) .filter-chip-count { background: var(--color-surface-soft); color: var(--color-ink-muted); }
  .resources-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.04em;
  }

  /* Lista */
  .resources-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }

  /* Card */
  .resource-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: border-color var(--transition-fast);
  }
  .resource-card[hidden] { display: none; }
  .resource-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .resource-card-type {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
    font-weight: var(--weight-regular);
  }
  .resource-card-icon { color: var(--color-warm); display: inline-flex; width: 16px; height: 16px; }
  .resource-card-icon :global(svg) { width: 100%; height: 100%; }

  .resource-card-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1rem;
  }

  .resource-card-doi {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-bottom: 1.25rem;
    background: var(--color-surface-soft);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
  }
  .resource-card-doi-label {
    font-weight: var(--weight-medium);
    color: var(--color-ink-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .resource-card-doi code { background: transparent; padding: 0; font-family: var(--font-mono); }

  .copy-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-ink-muted);
    padding: 0.2rem;
    display: inline-flex;
    align-items: center;
    border-radius: 4px;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .copy-btn:hover { color: var(--color-ink); background: var(--color-surface); }
  .copy-btn.is-copied { color: var(--color-success); }

  .resource-card-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    margin-bottom: 1.5rem;
    max-width: 56rem;
  }

  .resource-card-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 0 0 1.75rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .resource-card-metadata > div { display: flex; flex-direction: column; gap: 0.25rem; }
  .resource-card-metadata dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .resource-card-metadata dd {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink);
    margin: 0;
    font-weight: var(--weight-medium);
  }

  /* Acciones */
  .resource-card-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: white; }
  .btn-primary:active { transform: translateY(1px); }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .btn-secondary:hover { background: var(--color-surface-soft); border-color: var(--color-ink); }
  .btn-secondary[aria-expanded="true"] { background: var(--color-surface-soft); border-color: var(--color-ink); }

  .resource-card-feedback {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    text-decoration: none;
    margin-left: auto;
    transition: color var(--transition-fast);
  }
  .resource-card-feedback:hover { color: var(--color-ink); text-decoration: underline; }

  /* Pill de estado */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 0.35rem 0.7rem 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .status-pill.status-active { background: var(--color-success-soft); color: var(--color-success); }
  .status-pill.status-upcoming { background: var(--color-warm-soft); color: var(--color-warm-deep); }

  .status-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; position: relative; }
  .status-active .status-dot { background: var(--color-success); }
  .status-upcoming .status-dot { background: var(--color-warm); }
  .status-active .status-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--color-success);
    opacity: 0.4;
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.6); opacity: 0.4; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-active .status-dot::after { animation: none; }
  }

  /* Panel de citas */
  .cite-panel {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cite-panel[hidden] { display: none; }
  .cite-format { background: var(--color-surface-soft); border-radius: var(--radius-md); overflow: hidden; }
  .cite-format-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
