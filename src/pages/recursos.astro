---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const datasets = [
  {
    title: 'Minecraft Component Lists',
    desc: 'Recopilación y organización sistemática de los componentes de juego identificados en Minecraft Education, estructurada según el marco conceptual de Järvinen (2008).',
    doi: '10.5281/zenodo.15630826',
    href: 'https://zenodo.org/records/15630826',
    tipo: 'Dataset',
    estado: 'Disponible',
    publicado: 'Junio 2025',
    mcVersion: 'Minecraft 1.21.6',
  },
];
---

<BaseLayout
  title="Recursos"
  description="Recursos abiertos, datasets y herramientas de Javier García-Álvarez para docentes e investigadores en educación y tecnología educativa."
>
  <div class="max-w-3xl mx-auto px-6 py-16 space-y-16">

    <!-- Header -->
    <section class="space-y-4">
      <p class="text-sm font-medium text-brand-600 tracking-wide uppercase">Recursos</p>
      <h1 class="text-4xl font-heading font-semibold text-slate-900">Recursos abiertos</h1>
      <p class="text-lg text-slate-600 leading-relaxed">
        Lo que produzco mientras investigo, en abierto. Si te resulta útil, úsalo y cítame. Si encuentras un error, dímelo.
      </p>
    </section>

    <div class="border-t border-zinc-200" />

    <!-- Datasets -->
    <section class="space-y-8">
      <h2 class="text-2xl font-heading font-semibold text-slate-900">Datasets</h2>
      <div class="space-y-4">
        {datasets.map(({ title, desc, doi, href, tipo, estado, publicado, mcVersion }) => (
          <div class="rounded-2xl border border-slate-200 overflow-hidden hover:border-brand-200 hover:shadow-sm transition-all">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="text-slate-400">
                  <Icon name="Layers" size={22} />
                </span>
                <div>
                  <p class="font-medium text-slate-800">{title}</p>
                  <p class="text-xs text-slate-400 font-mono mt-0.5">DOI: {doi}</p>
                </div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-medium">{tipo}</span>
                <span class="px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-xs font-medium border border-green-100">{estado}</span>
              </div>
            </div>
            <div class="px-6 py-5 space-y-4">
              <p class="text-sm text-slate-600 leading-relaxed">{desc}</p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-400">Publicado: {publicado}{mcVersion ? ` · ${mcVersion}` : ''}</span>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors"
                >
                  Ver en Zenodo
                  <Icon name="ExternalLink" size={14} />
                </a>
              </div>
              <!-- Cita y feedback -->
              <details class="group border-t border-slate-100 pt-4">
                <summary class="flex items-center gap-4 cursor-pointer list-none text-xs text-slate-400 hover:text-slate-600 transition-colors select-none">
                  <span class="hover:text-brand-600 transition-colors">¿Cómo citar?</span>
                  <span class="text-slate-200">·</span>
                  <a href={`/contacto?recurso=${encodeURIComponent(title)}`} class="hover:text-brand-600 transition-colors">Feedback</a>
                </summary>
                <div class="mt-4 space-y-3">
                  <div>
                    <p class="text-xs font-medium text-slate-500 mb-1">APA</p>
                    <p class="text-xs text-slate-600 bg-slate-50 rounded-lg px-4 py-3 leading-relaxed font-mono">
                      García-Álvarez, J. (2025). <em>{title}</em>. Zenodo. https://doi.org/{doi}
                    </p>
                  </div>
                  <div>
                    <p class="text-xs font-medium text-slate-500 mb-1">BibTeX</p>
                    <pre class="text-xs text-slate-600 bg-slate-50 rounded-lg px-4 py-3 overflow-x-auto leading-relaxed">{`@misc{garciaAlvarez2025minecraft,
  author    = {García-Álvarez, Javier},
  title     = {${title}},
  year      = {2025},
  publisher = {Zenodo},
  doi       = {${doi}},
  url       = {${href}}
}`}</pre>
                  </div>
                </div>
              </details>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="border-t border-zinc-200" />

    <!-- Herramientas -->
    <section class="space-y-8">
      <h2 class="text-2xl font-heading font-semibold text-slate-900">Herramientas</h2>

      <div class="rounded-2xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="text-slate-400">
              <Icon name="Calculator" size={22} />
            </span>
            <div>
              <p class="font-medium text-slate-800">Calculadora de baremos universitarios</p>
              <p class="text-xs text-slate-500">Convocatorias universitarias · España</p>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-medium">Herramienta</span>
            <span class="px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-xs font-medium border border-green-100">Disponible</span>
          </div>
        </div>
        <div class="px-6 py-6 space-y-4">
          <p class="text-sm text-slate-600 leading-relaxed">
            Calcula automáticamente la puntuación de un expediente académico según los baremos de distintas convocatorias universitarias españolas (FPI, FPU, contratos predoctorales, etc.).
          </p>
          <ul class="space-y-1.5 text-sm text-slate-600">
            {[
              'Cálculo según múltiples convocatorias',
              'Exportación de resultados',
              'Interfaz sencilla, sin registro',
            ].map(feat => (
              <li class="flex items-center gap-2">
                <span class="text-brand-500 flex-shrink-0">
                  <Icon name="Check" size={16} />
                </span>
                {feat}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="https://www.notion.so/Tutorial-herramientas-de-c-lculo-2c0334b437154f7f9abcc2d82c1abd59"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors"
            >
              Descargar en Notion
              <Icon name="ExternalLink" size={14} />
            </a>
            <a
              href="https://www.notion.so/Tutorial-herramientas-de-c-lculo-2c0334b437154f7f9abcc2d82c1abd59"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-slate-500 hover:text-brand-700 transition-colors"
            >
              Ver tutorial extendido →
            </a>
          </div>
          <!-- Cita y feedback -->
          <details class="group border-t border-slate-100 pt-4">
            <summary class="flex items-center gap-4 cursor-pointer list-none text-xs text-slate-400 hover:text-slate-600 transition-colors select-none">
              <span class="hover:text-brand-600 transition-colors">¿Cómo citar?</span>
              <span class="text-slate-200">·</span>
              <a href="/contacto?recurso=Calculadora+de+baremos" class="hover:text-brand-600 transition-colors">Feedback</a>
            </summary>
            <div class="mt-4 space-y-3">
              <div>
                <p class="text-xs font-medium text-slate-500 mb-1">APA</p>
                <p class="text-xs text-slate-600 bg-slate-50 rounded-lg px-4 py-3 leading-relaxed font-mono">
                  García-Álvarez, J. (2024). <em>Calculadora de baremos universitarios</em> [Herramienta]. javiergarciaalvarez.com
                </p>
              </div>
              <div>
                <p class="text-xs font-medium text-slate-500 mb-1">BibTeX</p>
                <pre class="text-xs text-slate-600 bg-slate-50 rounded-lg px-4 py-3 overflow-x-auto leading-relaxed">{`@misc{garciaAlvarez2024baremos,
  author = {García-Álvarez, Javier},
  title  = {Calculadora de baremos universitarios},
  year   = {2024},
  url    = {https://javiergarciaalvarez.com/recursos}
}`}</pre>
              </div>
            </div>
          </details>
        </div>
      </div>
    </section>

    <div class="border-t border-zinc-200" />

    <!-- Otros -->
    <section class="space-y-8">
      <h2 class="text-2xl font-heading font-semibold text-slate-900">Otros</h2>

      <div class="rounded-2xl border border-slate-200 overflow-hidden hover:border-brand-200 hover:shadow-sm transition-all">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="text-slate-400">
              <Icon name="MapPin" size={22} />
            </span>
            <div>
              <p class="font-medium text-slate-800">Mapa Educraft (Minecraft Education)</p>
              <p class="text-xs text-slate-500">Mapa para Minecraft Education</p>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-medium">Mapa</span>
            <span class="px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-xs font-medium border border-green-100">Disponible</span>
          </div>
        </div>
        <div class="px-6 py-6 space-y-4">
          <p class="text-sm text-slate-600 leading-relaxed">
            Mapa de Minecraft Education listo para usar en el aula. Descárgalo desde Google Drive e impórtalo en Minecraft Education.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="https://bit.ly/3QDQ4MB"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors"
            >
              Descargar (Google Drive)
              <Icon name="ExternalLink" size={14} />
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-zinc-200" />

    <!-- Próximamente -->
    <section class="space-y-6">
      <h2 class="text-2xl font-heading font-semibold text-slate-900">Próximamente</h2>
      <div class="space-y-3">
        <div class="flex gap-4 p-5 rounded-xl bg-slate-50 border border-slate-100">
          <span class="text-slate-300 mt-0.5 flex-shrink-0">
            <Icon name="Clock" size={20} />
          </span>
          <div class="flex-1 space-y-2">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <p class="font-medium text-slate-700">GDD estandarizado</p>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-medium">Plantilla</span>
                <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-xs font-medium border border-amber-100">Próximamente</span>
              </div>
            </div>
            <p class="text-sm text-slate-500">Plantilla de Game Design Document adaptada a contextos de aprendizaje basado en juegos.</p>
            <div class="flex items-center justify-between flex-wrap gap-2 pt-1">
              <span class="text-xs text-slate-400">Fecha estimada: por confirmar</span>
              <a href="/contacto" class="text-xs text-brand-600 hover:text-brand-700 hover:underline transition-colors">
                Avisarme cuando esté listo →
              </a>
            </div>
          </div>
        </div>

        <div class="flex gap-4 p-5 rounded-xl bg-slate-50 border border-slate-100">
          <span class="text-slate-300 mt-0.5 flex-shrink-0">
            <Icon name="Clock" size={20} />
          </span>
          <div class="flex-1 space-y-2">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <p class="font-medium text-slate-700">Plantilla Dataset RSL</p>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-medium">Plantilla</span>
                <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-xs font-medium border border-amber-100">Próximamente</span>
              </div>
            </div>
            <p class="text-sm text-slate-500">Plantilla para estructurar y documentar el dataset de una Revisión Sistemática de Literatura (RSL).</p>
            <div class="flex items-center justify-between flex-wrap gap-2 pt-1">
              <span class="text-xs text-slate-400">Fecha estimada: por confirmar</span>
              <a href="/contacto" class="text-xs text-brand-600 hover:text-brand-700 hover:underline transition-colors">
                Avisarme cuando esté listo →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
