---
import BaseLayout from '../layouts/BaseLayout.astro';
import contenido from '../data/investigacion.json';

const { proyectoPrincipal, otrosProyectos, publicaciones } = contenido;
---

<BaseLayout
  title="Investigación"
  description="Proyectos de investigación de Javier García-Álvarez sobre Aprendizaje Basado en Juegos y tecnología educativa. Revisión Sistemática de Literatura en curso."
>
  <div class="research-page">

    <header class="page-header">
      <p class="eyebrow">02 / Investigación</p>
      <h1 class="page-title">Líneas de trabajo en curso</h1>
      <p class="page-lead">
        Lo que estoy investigando ahora mismo y los proyectos que mantengo activos en paralelo.
      </p>
    </header>

    <!-- Proyecto principal -->
    <section class="main-project">
      <div class="section-label">
        <span class="section-label-number">Proyecto principal</span>
        <span class:list={['status-pill', proyectoPrincipal.estadoClase]}>
          <span class="status-dot" aria-hidden="true"></span>
          {proyectoPrincipal.estado}
        </span>
      </div>

      <article class="main-project-card">
        <h2 class="main-project-title">
          {proyectoPrincipal.titulo}
        </h2>
        <p class="main-project-body">
          {proyectoPrincipal.cuerpo}
        </p>
        <ul class="main-project-tags" aria-label="Temas del proyecto">
          {proyectoPrincipal.tags.map(tag => (
            <li>{tag}</li>
          ))}
        </ul>
      </article>
    </section>

    <!-- Otros proyectos -->
    <section class="other-projects">
      <h2 class="subsection-title">Otros proyectos</h2>
      <ul class="other-projects-list">
        {otrosProyectos.map(proyecto => (
          <li class="other-project">
            <div class="other-project-main">
              <h3 class="other-project-title">
                {proyecto.titulo}
              </h3>
              <p class="other-project-body">
                {proyecto.cuerpo}
              </p>
            </div>
            <div class="other-project-meta">
              <span class:list={['other-project-status', proyecto.estadoClase]}>
                <span class="status-dot" aria-hidden="true"></span>
                {proyecto.estado}
              </span>
              <ul class="other-project-tags">
                {proyecto.tags.map(tag => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Publicaciones -->
    <section class="publications">
      <h2 class="subsection-title">Publicaciones</h2>

      {publicaciones.map(pub => (
        <article class="publication">
          {pub.estado && (
            <span class="publication-status status-pill status-active">
              <span class="status-dot" aria-hidden="true"></span>
              {pub.estado}
            </span>
          )}
          <h3 class="publication-title">
            {pub.url ? (
              <a href={pub.url} target="_blank" rel="noopener">{pub.titulo}</a>
            ) : pub.titulo}
          </h3>
          <p class="publication-meta">
            {pub.autores} ({pub.anio}). <em>{pub.revista}</em>.{pub.editorial ? ` ${pub.editorial}.` : ''}
          </p>
          {pub.url && (
            <a class="publication-link" href={pub.url} target="_blank" rel="noopener">
              Ver en Google Scholar <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </section>

  </div>
</BaseLayout>

<style>
  /* ── Página Investigación (Fase 5) ── usa tokens de tokens.css ── */
  .research-page {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  /* Header de página */
  .page-header {
    margin-bottom: calc(var(--space-section) * 0.6);
    max-width: 42rem;
  }
  .page-header .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
  }
  .page-lead {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  /* Proyecto principal */
  .main-project {
    margin-bottom: calc(var(--space-section) * 0.8);
  }
  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .section-label-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    font-weight: var(--weight-regular);
  }

  /* Pill de estado */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 0.35rem 0.7rem 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .status-pill.status-active { background: var(--color-success-soft); color: var(--color-success); }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    position: relative;
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--color-success);
    opacity: 0.4;
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.6); opacity: 0.4; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot::after { animation: none; }
  }

  /* Card del proyecto principal */
  .main-project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2.25rem;
    position: relative;
  }
  .main-project-card::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 3px;
    background: var(--color-warm);
    border-radius: 2px;
  }
  .main-project-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
    padding-right: 2rem;
  }
  .main-project-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin-bottom: 2rem;
    max-width: 56rem;
  }
  .main-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-project-tags li {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
  }

  /* Otros proyectos — lista editorial */
  .other-projects {
    margin-top: calc(var(--space-section) * 0.6);
  }
  .subsection-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .other-projects-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .other-project {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: start;
  }
  .other-project:last-child { border-bottom: none; }
  .other-project-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 0.75rem;
  }
  .other-project-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 42rem;
  }
  .other-project-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    min-width: 12rem;
  }
  .other-project-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .other-project-status.status-active { background: var(--color-success-soft); color: var(--color-success); }
  .other-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: flex-end;
  }
  .other-project-tags li {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: var(--weight-medium);
    color: var(--color-ink-muted);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  /* Estados alternativos (preparados) */
  .status-pill.status-completed,
  .other-project-status.status-completed {
    background: var(--color-surface-soft);
    color: var(--color-ink-soft);
  }
  .status-pill.status-completed .status-dot,
  .other-project-status.status-completed .status-dot { background: var(--color-ink-muted); }
  .status-pill.status-completed .status-dot::after,
  .other-project-status.status-completed .status-dot::after { display: none; }

  .status-pill.status-paused,
  .other-project-status.status-paused {
    background: #FBE9D9;
    color: var(--color-warm-deep);
  }
  .status-pill.status-paused .status-dot,
  .other-project-status.status-paused .status-dot { background: var(--color-warm); }
  .status-pill.status-paused .status-dot::after,
  .other-project-status.status-paused .status-dot::after { display: none; }

  /* Publicaciones (adaptada al sistema, sin morado) */
  .publications { margin-top: calc(var(--space-section) * 0.6); }
  .publication-title {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }
  .publication-title a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .publication-title a:hover { color: var(--color-warm); }
  .publication-meta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-bottom: 0.6rem;
  }
  .publication-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .publication-link:hover { color: var(--color-ink); }
  .publication + .publication {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .publication-status {
    display: inline-flex;
    margin-bottom: 0.75rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .other-project {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .other-project-meta {
      align-items: flex-start;
      min-width: 0;
    }
    .other-project-tags { justify-content: flex-start; }
  }
</style>
