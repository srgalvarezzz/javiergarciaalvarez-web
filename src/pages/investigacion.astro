---
import BaseLayout from '../layouts/BaseLayout.astro';
import contenido from '../data/investigacion.json';
import { ultimaActualizacion } from '../utils/fechas';
import { articulo } from '../utils/jsonld';

const { proyectoPrincipal, publicaciones, comunicaciones, revisiones } = contenido;

const totalRevisiones = revisiones.reduce((suma, r) => suma + r.numero, 0);

// Se deriva del máximo de las entradas, nunca se escribe a mano (tarea 3.3).
const actualizado = ultimaActualizacion([proyectoPrincipal, ...publicaciones]);

const datosEstructurados = publicaciones.map(articulo);
---

<BaseLayout
  title="Investigación"
  description="Proyectos de investigación de Javier García-Álvarez sobre Aprendizaje Basado en Juegos y tecnología educativa. Revisión Sistemática de Literatura en curso."
  ogImage="/og-investigacion.png"
  jsonLd={datosEstructurados}
>
  <div class="research-page">

    <header class="page-header">
      <p class="eyebrow">Investigación</p>
      <h1 class="page-title">Líneas de trabajo en curso</h1>
      <p class="page-lead">
        Lo que estoy investigando ahora mismo y los proyectos que mantengo activos en paralelo.
      </p>
    </header>

    <!-- Proyecto principal -->
    <section class="main-project">
      <div class="section-label">
        <span class="section-label-number">Proyecto principal</span>
        <span class:list={['status-pill', proyectoPrincipal.estadoClase]}>
          <span class="status-dot" aria-hidden="true"></span>
          {proyectoPrincipal.estado}
        </span>
      </div>

      <article class="main-project-card">
        <h2 class="main-project-title">
          {proyectoPrincipal.titulo}
        </h2>
        <p class="main-project-body">
          {proyectoPrincipal.cuerpo}
        </p>
        <ul class="main-project-tags" aria-label="Temas del proyecto">
          {proyectoPrincipal.tags.map(tag => (
            <li>{tag}</li>
          ))}
        </ul>
      </article>
    </section>

    <!-- Publicaciones -->
    <section class="publications">
      <h2 class="subsection-title">Publicaciones</h2>

      {publicaciones.map(pub => (
        <article class="publication">
          {pub.estado && (
            <span class:list={['publication-status', 'status-pill', pub.estadoClase]}>
              <span class="status-dot" aria-hidden="true"></span>
              {pub.estado}
            </span>
          )}
          {/* El título lleva al DOI, que es la dirección canónica del trabajo.
              Cuando no hay DOI todavía —en prensa o en revisión— se queda como
              texto: enlazar a otra parte confundiría sobre qué es un DOI. */}
          <h3 class="publication-title">
            {pub.doi ? (
              <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">{pub.titulo}</a>
            ) : pub.titulo}
          </h3>
          {/* Una entrada en revisión aún no tiene revista ni año que citar, así
              que la línea de referencia solo se pinta cuando hay algo que poner. */}
          {pub.autores && pub.autores.length > 0 && pub.revista && (
            <p class="publication-meta">
              {pub.autores.map((autor, i) => (
                <Fragment>
                  {i > 0 ? (i === pub.autores.length - 1 ? ' & ' : ', ') : ''}
                  {autor.orcid ? (
                    <a
                      href={`https://orcid.org/${autor.orcid}`}
                      target="_blank"
                      rel="noopener"
                      class="autor-orcid"
                      title={`Perfil ORCID de ${autor.nombre}`}
                    >{autor.nombre}</a>
                  ) : autor.nombre}
                </Fragment>
              ))}
              {' '}({pub.anio}).{' '}
              {/* Sin saltos de línea dentro del <em>: el espacio en blanco del
                  marcado se renderiza y dejaba "Games and Culture . SAGE." */}
              <em>{pub.revistaUrl ? (<a href={pub.revistaUrl} target="_blank" rel="noopener">{pub.revista}</a>) : pub.revista}</em>.{pub.editorial ? ` ${pub.editorial}.` : ''}
              {/* APA 7 cierra la referencia con el DOI como URL completa, sin
                  etiqueta "DOI:" delante ni punto detrás. Al ponerlo aquí, la
                  línea suelta que había debajo sobraba: era el mismo dato y el
                  mismo destino, repetidos. */}
              {pub.doi && (
                <Fragment>
                  {' '}
                  <a
                    href={`https://doi.org/${pub.doi}`}
                    target="_blank"
                    rel="noopener"
                    class="publication-doi-enlace"
                  >https://doi.org/{pub.doi}</a>
                </Fragment>
              )}
            </p>
          )}
          {pub.resumen && (
            <p class="publication-body">{pub.resumen}</p>
          )}
          {/* La divulgación propia va como botón y no en el título: el título
              pertenece al DOI, y mezclar ambos destinos en el mismo elemento
              haría imposible saber adónde lleva un clic.

              Ya no hay enlace a Google Scholar. El DOI del título es la
              dirección canónica del artículo y Scholar solo era una segunda
              puerta a lo mismo. Sigue declarado como sameAs en el JSON-LD,
              donde sirve para desambiguar la identidad del trabajo. */}
          {pub.paginaPropia && (
            <div class="publication-actions">
              <a href={pub.paginaPropia} class="btn-secondary">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15" height="15">
                  <path d="M3 3v18h18" /><path d="M7 15l4-5 3 3 5-7" />
                </svg>
                Resultados
              </a>
            </div>
          )}
        </article>
      ))}
    </section>

    <!-- Comunicaciones y congresos (4.3) -->
    <section class="publications">
      <h2 class="subsection-title">Comunicaciones y congresos</h2>

      {comunicaciones.map(com => (
        <article class="publication">
          <h3 class="publication-title">{com.titulo}</h3>
          {/* Las comunicaciones no son en solitario, pero no se listan los
              demás participantes por decisión del autor. Se omite la línea de
              autoría en todas por igual: mostrarla solo en algunas haría leer
              la ausencia como "esta sí fue en solitario". */}
          <p class="publication-meta">
            {com.tipo} · <em>{com.congreso}</em>. {com.lugar}, {com.fechaTexto}.
          </p>
        </article>
      ))}
    </section>

    <!-- Revisión por pares (4.4): bloque compacto, sin ficha por entrada -->
    <section class="peer-review">
      <h2 class="subsection-title">Revisión por pares</h2>
      <p class="peer-review-lead">
        {totalRevisiones} revisiones para {revisiones.length} revistas.
      </p>
      <ul class="peer-review-list">
        {revisiones.map(rev => (
          <li>
            <span class="peer-review-journal">{rev.revista}</span>
            {rev.editorial && <span class="peer-review-publisher"> · {rev.editorial}</span>}
            <span class="peer-review-count">
              {rev.anio} · {rev.numero} {rev.numero === 1 ? 'revisión' : 'revisiones'}
            </span>
          </li>
        ))}
      </ul>
    </section>

    {actualizado && (
      <p class="page-updated">Última actualización: {actualizado}</p>
    )}

  </div>
</BaseLayout>

<style>
  /* ── Página Investigación (Fase 5) ── usa tokens de tokens.css ── */
  .research-page {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  /* Header de página */
  .page-header {
    margin-bottom: calc(var(--space-section) * 0.6);
    max-width: 42rem;
  }
  .page-header .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
  }
  .page-lead {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  /* Proyecto principal */
  .main-project {
    margin-bottom: calc(var(--space-section) * 0.8);
  }
  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .section-label-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    font-weight: var(--weight-regular);
  }

  /* Pill de estado */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 0.35rem 0.7rem 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .status-pill.status-active { background: var(--color-success-soft); color: var(--color-success); }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    position: relative;
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--color-success);
    opacity: 0.4;
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.6); opacity: 0.4; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot::after { animation: none; }
  }

  /* Card del proyecto principal */
  .main-project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2.25rem;
    position: relative;
  }
  .main-project-card::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 3px;
    background: var(--color-warm);
    border-radius: 2px;
  }
  .main-project-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
    padding-right: 2rem;
  }
  .main-project-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin-bottom: 2rem;
    max-width: 56rem;
  }
  .main-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-project-tags li {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .subsection-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  /* Estados alternativos (preparados) */
  .status-pill.status-completed {
    background: var(--color-surface-soft);
    color: var(--color-ink-soft);
  }
  .status-pill.status-completed .status-dot { background: var(--color-ink-muted); }
  .status-pill.status-completed .status-dot::after { display: none; }

  .status-pill.status-paused {
    background: #FBE9D9;
    color: var(--color-warm-deep);
  }
  .status-pill.status-paused .status-dot { background: var(--color-warm); }
  .status-pill.status-paused .status-dot::after { display: none; }

  /* Publicaciones (adaptada al sistema, sin morado) */
  .publications { margin-top: calc(var(--space-section) * 0.6); }
  .publication-title {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }
  .publication-title a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .publication-title a:hover { color: var(--color-warm); }

  /* Autoría enlazada a ORCID. La franja terracota barre de izquierda a derecha
     al pasar por encima y al recibir el foco, para anunciar que el nombre es
     pulsable sin llenar la línea de subrayados permanentes.

     Se dibuja con background-size y no con ::after porque un nombre puede
     partirse de línea, y un pseudoelemento solo subrayaría el último trozo.
     Con box-decoration-break cada fragmento recibe el suyo. */
  .autor-orcid {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--color-warm), var(--color-warm));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1.5px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: background-size var(--transition-base), color var(--transition-fast);
  }
  .autor-orcid:hover,
  .autor-orcid:focus-visible { background-size: 100% 1.5px; color: var(--color-ink); }

  .publication-meta em a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 2px;
    transition: text-decoration-color var(--transition-fast);
  }
  .publication-meta em a:hover { text-decoration-color: var(--color-warm); }

  /* El DOI cierra la referencia, dentro de la propia línea. Se subraya en
     suave y solo se refuerza al pasar por encima: en una cita APA la URL
     forma parte del texto, y un enlace chillón la partiría en dos. */
  .publication-doi-enlace {
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 2px;
    word-break: break-all;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }
  .publication-doi-enlace:hover {
    color: var(--color-warm-deep);
    text-decoration-color: var(--color-warm);
  }

  .publication-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.9rem;
  }

  /* Mismo botón que "Cómo citar" en /recursos, para que se lean como la misma
     familia de acciones secundarias. */
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }
  .btn-secondary:hover { background: var(--color-surface-soft); border-color: var(--color-ink); }

  @media (prefers-reduced-motion: reduce) {
    .autor-orcid { transition: none; }
  }
  .publication-meta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-bottom: 0.6rem;
  }
  .publication-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .publication-link:hover { color: var(--color-ink); }
  .publication + .publication {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .publication-status {
    display: inline-flex;
    margin-bottom: 0.75rem;
  }
  /* Resumen de una entrada aún sin referencia que mostrar. Hereda del cuerpo
     que usaba la lista de proyectos, para no introducir un tamaño nuevo. */
  .publication-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 42rem;
    margin-bottom: 0.6rem;
  }

  /* Revisión por pares (4.4): compacto a propósito, una línea por revista. */
  .peer-review { margin-top: calc(var(--space-section) * 0.6); }
  .peer-review-lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink-soft);
    margin-bottom: 1.25rem;
  }
  .peer-review-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .peer-review-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }
  .peer-review-list li:last-child { border-bottom: none; padding-bottom: 0; }
  .peer-review-journal {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
  }
  .peer-review-publisher {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .peer-review-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .peer-review-count { margin-left: 0; }
  }

  /* Pie de última actualización (tarea 3.3) */
  .page-updated {
    margin-top: calc(var(--space-section) * 0.5);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
</style>
