---
import BaseLayout from '../layouts/BaseLayout.astro';
import metricsFallback from '../data/metrics.json';

// Métricas de Google Scholar — se intentan leer en tiempo de build.
// Si Scholar bloquea la petición o cambia el HTML, se usan los últimos
// valores conocidos de src/data/metrics.json (respaldo).
const SCHOLAR_PROFILE = 'https://scholar.google.com/citations?hl=es&user=mYf-JyQAAAAJ&pagesize=100';

async function getMetrics() {
  try {
    const res = await fetch(SCHOLAR_PROFILE, {
      headers: {
        'User-Agent':
          'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36',
        'Accept-Language': 'es-ES,es;q=0.9',
      },
      signal: AbortSignal.timeout(8000),
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const html = await res.text();

    // Tabla de estadísticas: columna "Todo" en el orden Citas, Índice h, Índice i10.
    const stats = [...html.matchAll(/<td class="gsc_rsb_std">(\d[\d.,]*)<\/td>/g)].map((m) =>
      m[1].replace(/[.,]/g, ''),
    );
    const citas = stats[0];
    const hIndex = stats[2];

    // Nº de publicaciones = filas de artículos listadas.
    const pubRows = html.match(/class="gsc_a_tr"/g);
    const publicaciones = pubRows ? String(pubRows.length) : null;

    if (!citas || !hIndex) throw new Error('No se pudo parsear el perfil');

    return {
      citas,
      hIndex,
      publicaciones: publicaciones ?? metricsFallback.publicaciones,
      updated: new Date().toISOString().slice(0, 10),
    };
  } catch {
    return metricsFallback;
  }
}

const metrics = await getMetrics();
---

<BaseLayout
  title="Investigación"
  description="Proyectos de investigación de Javier García-Álvarez sobre Aprendizaje Basado en Juegos y tecnología educativa. Revisión Sistemática de Literatura en curso."
>
  <div class="max-w-3xl mx-auto px-6 py-16 space-y-16">

    <!-- Header -->
    <section>
      <p class="text-sm font-medium text-brand-600 tracking-wide uppercase">Investigación</p>
    </section>

    <!-- RSL en curso — TEASER -->
    <section class="space-y-6">
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-heading font-semibold text-slate-900">Proyecto principal</h2>
        <span class="px-2.5 py-0.5 rounded-full bg-accent-400/15 text-accent-500 text-xs font-semibold uppercase tracking-wide">En curso</span>
      </div>

      <div class="rounded-2xl border border-brand-100 bg-brand-50/50 p-8 space-y-4">
        <h3 class="text-xl font-heading font-semibold text-brand-900">
          Revisión Sistemática de Literatura sobre el uso de Inteligencia Artificial para el desarrollo del pensamiento crítico en Educación Superior
        </h3>
        <p class="text-slate-700 leading-relaxed">
          Esta RSL examina el estado de la evidencia empírica sobre el uso de herramientas y metodologías basadas en Inteligencia Artificial para el desarrollo del pensamiento crítico en entornos universitarios. El objetivo es identificar enfoques pedagógicos efectivos, condiciones de implementación y lagunas de conocimiento que orienten el diseño educativo con IA.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          {['Inteligencia Artificial', 'Pensamiento Crítico', 'Educación Superior', 'RSL / Systematic Review', 'Diseño instruccional', 'IA generativa'].map(tag => (
            <span class="px-2.5 py-1 rounded-md bg-brand-100 text-brand-700 text-xs font-medium">{tag}</span>
          ))}
        </div>
        <p class="text-sm text-slate-500 pt-2">
          Resultados esperados: 2025 Q4 – 2026 Q1.
        </p>
      </div>
    </section>

    <div class="border-t border-zinc-200" />

    <!-- Otros proyectos -->
    <section class="space-y-6">
      <h2 class="text-2xl font-heading font-semibold text-slate-900">Otros proyectos</h2>

      <div class="rounded-2xl border border-slate-200 p-8 space-y-4">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <h3 class="text-xl font-heading font-semibold text-slate-900">
            La Mecánica de Juego como Indicador del Aprendizaje: una Revisión Sistemática de la Evaluación Integrada en los Juegos Educativos
          </h3>
          <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-500 text-xs font-semibold uppercase tracking-wide whitespace-nowrap">Pendiente de publicar</span>
        </div>
        <p class="text-slate-700 leading-relaxed">
          Esta revisión sistemática analiza cómo las mecánicas de juego pueden actuar como indicadores válidos del aprendizaje en juegos educativos, revisando el estado del arte sobre evaluación integrada o embedded assessment. El objetivo es determinar bajo qué condiciones metodológicas se ha demostrado su validez.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          {['Mecánicas de juego', 'Evaluación integrada', 'Game-Based Learning', 'Educación Superior', 'Stealth Assessment', 'RSL / Systematic Review'].map(tag => (
            <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 text-xs font-medium">{tag}</span>
          ))}
        </div>
        <p class="text-sm text-slate-500 pt-2">Resultados esperados: 2025 Q3.</p>
      </div>

      <div class="rounded-2xl border border-slate-200 p-8 space-y-4">
        <h3 class="text-xl font-heading font-semibold text-slate-900">
          Ontología de mecánicas de juego
        </h3>
        <p class="text-slate-700 leading-relaxed">
          Desarrollo de una ontología formal que clasifica y estructura las mecánicas de juego como unidades de análisis en el diseño de juegos educativos. El objetivo es proporcionar un marco conceptual compartido que facilite la comparación entre estudios, el diseño fundamentado y la operacionalización de mecánicas en contextos de investigación.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          {['Ontología', 'Mecánicas de juego', 'Game Design', 'Game-Based Learning', 'Marco conceptual', 'Taxonomía'].map(tag => (
            <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 text-xs font-medium">{tag}</span>
          ))}
        </div>
        <p class="text-sm text-slate-500 pt-2">Resultados esperados: 2025 Q4 – 2026 Q1.</p>
      </div>
    </section>

    <div class="border-t border-zinc-200" />

    <!-- Publicaciones -->
    <section class="space-y-6">
      <h2 class="text-2xl font-heading font-semibold text-slate-900">Publicaciones</h2>
      <article class="rounded-2xl border border-slate-200 p-6 space-y-2">
        <h3 class="font-heading font-semibold text-slate-900 leading-snug">
          <a
            href="https://scholar.google.com/citations?view_op=view_citation&hl=es&user=mYf-JyQAAAAJ&citation_for_view=mYf-JyQAAAAJ:u5HHmVD_uO8C"
            target="_blank"
            rel="noopener"
            class="hover:text-brand-700 transition-colors"
          >
            Minecraft as a Pedagogical Tool: A Systematic Literature Review (2014–2024)
          </a>
        </h3>
        <p class="text-sm text-slate-600">
          García-Álvarez, J. &amp; Acevedo-Borrega, J. (2025). <em>Games and Culture</em>. SAGE.
        </p>
        <a
          href="https://scholar.google.com/citations?view_op=view_citation&hl=es&user=mYf-JyQAAAAJ&citation_for_view=mYf-JyQAAAAJ:u5HHmVD_uO8C"
          target="_blank"
          rel="noopener"
          class="inline-block text-sm text-brand-700 hover:underline"
        >
          Ver en Google Scholar ↗
        </a>
      </article>
    </section>

    <div class="border-t border-zinc-200" />

    <!-- Métricas -->
    <section class="space-y-6">
      <h2 class="text-2xl font-heading font-semibold text-slate-900">Métricas</h2>
      <div class="grid grid-cols-3 gap-4">
        {([
          { label: 'Citas', value: metrics.citas },
          { label: 'Índice h', value: metrics.hIndex },
          { label: 'Publicaciones', value: metrics.publicaciones },
        ]).map(({ label, value }) => (
          <div class="rounded-2xl border border-slate-200 p-6 text-center">
            <p class="text-3xl font-heading font-semibold text-brand-700">{value}</p>
            <p class="mt-1 text-sm text-slate-500">{label}</p>
          </div>
        ))}
      </div>
      <p class="text-sm text-slate-500">
        Fuente: <a href="https://scholar.google.es/citations?user=mYf-JyQAAAAJ&hl=es" target="_blank" rel="noopener" class="text-brand-700 hover:underline">Google Scholar</a> · actualizado el {metrics.updated}.
      </p>
    </section>

  </div>
</BaseLayout>
