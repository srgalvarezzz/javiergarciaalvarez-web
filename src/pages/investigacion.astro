---
import BaseLayout from '../layouts/BaseLayout.astro';
import contenido from '../data/investigacion.json';
import { ultimaActualizacion } from '../utils/fechas';
import { articulo } from '../utils/jsonld';

const { proyectoPrincipal, publicaciones, comunicaciones, revisiones } = contenido;

const totalRevisiones = revisiones.reduce((suma, r) => suma + r.numero, 0);

// Se deriva del máximo de las entradas, nunca se escribe a mano (tarea 3.3).
const actualizado = ultimaActualizacion([proyectoPrincipal, ...publicaciones]);

// "A, B & C": coma entre todos menos el último, que va con ampersand.
const listarAutores = (nombres: string[]) =>
  nombres.length <= 1 ? nombres[0] ?? '' : `${nombres.slice(0, -1).join(', ')} & ${nombres[nombres.length - 1]}`;

const datosEstructurados = publicaciones.map(articulo);
---

<BaseLayout
  title="Investigación"
  description="Proyectos de investigación de Javier García-Álvarez sobre Aprendizaje Basado en Juegos y tecnología educativa. Revisión Sistemática de Literatura en curso."
  ogImage="/og-investigacion.png"
  jsonLd={datosEstructurados}
>
  <div class="research-page">

    <header class="page-header">
      <p class="eyebrow">Investigación</p>
      <h1 class="page-title">Líneas de trabajo en curso</h1>
      <p class="page-lead">
        Lo que estoy investigando ahora mismo y los proyectos que mantengo activos en paralelo.
      </p>
    </header>

    <!-- Proyecto principal -->
    <section class="main-project">
      <div class="section-label">
        <span class="section-label-number">Proyecto principal</span>
        <span class:list={['status-pill', proyectoPrincipal.estadoClase]}>
          <span class="status-dot" aria-hidden="true"></span>
          {proyectoPrincipal.estado}
        </span>
      </div>

      <article class="main-project-card">
        <h2 class="main-project-title">
          {proyectoPrincipal.titulo}
        </h2>
        <p class="main-project-body">
          {proyectoPrincipal.cuerpo}
        </p>
        <ul class="main-project-tags" aria-label="Temas del proyecto">
          {proyectoPrincipal.tags.map(tag => (
            <li>{tag}</li>
          ))}
        </ul>
      </article>
    </section>

    <!-- Publicaciones -->
    <section class="publications">
      <h2 class="subsection-title">Publicaciones</h2>

      {publicaciones.map(pub => (
        <article class="publication">
          {pub.estado && (
            <span class:list={['publication-status', 'status-pill', pub.estadoClase]}>
              <span class="status-dot" aria-hidden="true"></span>
              {pub.estado}
            </span>
          )}
          <h3 class="publication-title">
            {pub.url ? (
              <a href={pub.url} target="_blank" rel="noopener">{pub.titulo}</a>
            ) : pub.titulo}
          </h3>
          {/* Una entrada en revisión aún no tiene revista ni año que citar, así
              que la línea de referencia solo se pinta cuando hay algo que poner. */}
          {pub.autores && pub.autores.length > 0 && pub.revista && (
            <p class="publication-meta">
              {listarAutores(pub.autores)} ({pub.anio}). <em>{pub.revista}</em>.{pub.editorial ? ` ${pub.editorial}.` : ''}
            </p>
          )}
          {pub.resumen && (
            <p class="publication-body">{pub.resumen}</p>
          )}
          {pub.url && (
            <a class="publication-link" href={pub.url} target="_blank" rel="noopener">
              Ver en Google Scholar <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </section>

    <!-- Comunicaciones y congresos (4.3) -->
    <section class="publications">
      <h2 class="subsection-title">Comunicaciones y congresos</h2>

      {comunicaciones.map(com => (
        <article class="publication">
          <h3 class="publication-title">{com.titulo}</h3>
          {/* Las comunicaciones no son en solitario, pero no se listan los
              demás participantes por decisión del autor. Se omite la línea de
              autoría en todas por igual: mostrarla solo en algunas haría leer
              la ausencia como "esta sí fue en solitario". */}
          <p class="publication-meta">
            {com.tipo} · <em>{com.congreso}</em>. {com.lugar}, {com.fechaTexto}.
          </p>
        </article>
      ))}
    </section>

    <!-- Revisión por pares (4.4): bloque compacto, sin ficha por entrada -->
    <section class="peer-review">
      <h2 class="subsection-title">Revisión por pares</h2>
      <p class="peer-review-lead">
        {totalRevisiones} revisiones para {revisiones.length} revistas.
      </p>
      <ul class="peer-review-list">
        {revisiones.map(rev => (
          <li>
            <span class="peer-review-journal">{rev.revista}</span>
            {rev.editorial && <span class="peer-review-publisher"> · {rev.editorial}</span>}
            <span class="peer-review-count">
              {rev.anio} · {rev.numero} {rev.numero === 1 ? 'revisión' : 'revisiones'}
            </span>
          </li>
        ))}
      </ul>
    </section>

    {actualizado && (
      <p class="page-updated">Última actualización: {actualizado}</p>
    )}

  </div>
</BaseLayout>

<style>
  /* ── Página Investigación (Fase 5) ── usa tokens de tokens.css ── */
  .research-page {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  /* Header de página */
  .page-header {
    margin-bottom: calc(var(--space-section) * 0.6);
    max-width: 42rem;
  }
  .page-header .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
  }
  .page-lead {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 36rem;
  }

  /* Proyecto principal */
  .main-project {
    margin-bottom: calc(var(--space-section) * 0.8);
  }
  .section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .section-label-number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    font-weight: var(--weight-regular);
  }

  /* Pill de estado */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    padding: 0.35rem 0.7rem 0.35rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }
  .status-pill.status-active { background: var(--color-success-soft); color: var(--color-success); }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    position: relative;
  }
  .status-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--color-success);
    opacity: 0.4;
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.6); opacity: 0.4; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot::after { animation: none; }
  }

  /* Card del proyecto principal */
  .main-project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2.25rem;
    position: relative;
  }
  .main-project-card::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 3px;
    background: var(--color-warm);
    border-radius: 2px;
  }
  .main-project-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
    padding-right: 2rem;
  }
  .main-project-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin-bottom: 2rem;
    max-width: 56rem;
  }
  .main-project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-project-tags li {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-ink-soft);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .subsection-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  /* Estados alternativos (preparados) */
  .status-pill.status-completed {
    background: var(--color-surface-soft);
    color: var(--color-ink-soft);
  }
  .status-pill.status-completed .status-dot { background: var(--color-ink-muted); }
  .status-pill.status-completed .status-dot::after { display: none; }

  .status-pill.status-paused {
    background: #FBE9D9;
    color: var(--color-warm-deep);
  }
  .status-pill.status-paused .status-dot { background: var(--color-warm); }
  .status-pill.status-paused .status-dot::after { display: none; }

  /* Publicaciones (adaptada al sistema, sin morado) */
  .publications { margin-top: calc(var(--space-section) * 0.6); }
  .publication-title {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.4rem;
  }
  .publication-title a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .publication-title a:hover { color: var(--color-warm); }
  .publication-meta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    margin-bottom: 0.6rem;
  }
  .publication-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .publication-link:hover { color: var(--color-ink); }
  .publication + .publication {
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .publication-status {
    display: inline-flex;
    margin-bottom: 0.75rem;
  }
  /* Resumen de una entrada aún sin referencia que mostrar. Hereda del cuerpo
     que usaba la lista de proyectos, para no introducir un tamaño nuevo. */
  .publication-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 42rem;
    margin-bottom: 0.6rem;
  }

  /* Revisión por pares (4.4): compacto a propósito, una línea por revista. */
  .peer-review { margin-top: calc(var(--space-section) * 0.6); }
  .peer-review-lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink-soft);
    margin-bottom: 1.25rem;
  }
  .peer-review-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .peer-review-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }
  .peer-review-list li:last-child { border-bottom: none; padding-bottom: 0; }
  .peer-review-journal {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
  }
  .peer-review-publisher {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .peer-review-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .peer-review-count { margin-left: 0; }
  }

  /* Pie de última actualización (tarea 3.3) */
  .page-updated {
    margin-top: calc(var(--space-section) * 0.5);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
</style>
