---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Página no encontrada">
  <div class="error-page">
    <p class="error-code">404</p>
    <h1 class="error-title">Esta ruta no lleva a ningún lugar conocido.</h1>
    <p class="error-lead">
      O bien el enlace está mal escrito, o bien algo que existía aquí
      ya no existe. En investigación pasa lo mismo: a veces los caminos
      que prometen no llevan a donde uno esperaba.
    </p>
    <div class="error-actions">
      <a href="/" class="btn-primary">Volver al inicio</a>
      <a href="/investigacion" class="link-arrow">
        Ver mi investigación
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    max-width: 38rem;
    margin: 0 auto;
    padding: calc(var(--space-section) * 1.2) 1.5rem;
    text-align: center;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-warm);
    letter-spacing: 0.3em;
    margin-bottom: 2rem;
  }

  .error-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
  }

  .error-lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin-bottom: 2.5rem;
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  /* Botones reutilizados (definidos por página por el scoping de Astro) */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }
  .btn-primary:hover { background: var(--color-accent-hover); color: white; }
  .btn-primary:active { transform: translateY(1px); }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    transition: gap var(--transition-base), color var(--transition-fast);
  }
  .link-arrow:hover { color: var(--color-accent); gap: 0.7rem; }
  .link-arrow span { transition: transform var(--transition-base); }
  .link-arrow:hover span { transform: translateX(2px); }
</style>
