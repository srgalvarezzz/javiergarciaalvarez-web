---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Inicio" description="Javier García-Álvarez, doctorando FPI en Educación Tecnológica en la Universidad de Extremadura. Investigación en Aprendizaje Basado en Juegos y tecnología educativa.">

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-16 flex flex-col md:flex-row items-center gap-12">
    <div class="flex-1 space-y-6">
      <p class="text-sm font-medium text-brand-600 tracking-wide uppercase">Doctorando FPI · Universidad de Extremadura</p>
      <h1 class="text-4xl md:text-5xl font-heading font-semibold text-slate-900 leading-tight">
        Investigando cómo los<br />
        <em class="not-italic text-brand-700">juegos transforman</em><br />
        el aprendizaje
      </h1>
      <p class="text-lg text-slate-600 max-w-xl">
        Estudio el potencial del Aprendizaje Basado en Juegos (GBL) y la tecnología educativa para mejorar experiencias de aprendizaje reales.
      </p>
      <div class="flex items-center gap-4 pt-2">
        <a href="/investigacion" class="px-5 py-2.5 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors">
          Ver mi investigación
        </a>
        <a href="/sobre-mi" class="px-5 py-2.5 text-brand-700 text-sm font-medium hover:underline">
          Sobre mí →
        </a>
      </div>
    </div>

    <!-- Avatar placeholder -->
    <div class="w-48 h-48 md:w-56 md:h-56 rounded-full bg-brand-50 border-4 border-brand-100 flex items-center justify-center flex-shrink-0">
      <span class="text-5xl">👤</span>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-6">
    <hr class="border-slate-100" />
  </div>

  <!-- Areas de interés -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-heading font-semibold text-slate-900 mb-10">Áreas de investigación</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { emoji: '🎮', title: 'Game-Based Learning', desc: 'Diseño y evaluación de experiencias de aprendizaje mediadas por el juego en contextos educativos formales.' },
        { emoji: '🔬', title: 'Revisión Sistemática', desc: 'Síntesis de evidencia sobre el impacto del GBL mediante metodología RSL rigurosa.' },
        { emoji: '🛠️', title: 'Tecnología Educativa', desc: 'Desarrollo y validación de herramientas digitales para docentes y estudiantes universitarios.' },
      ].map(({ emoji, title, desc }) => (
        <div class="p-6 rounded-xl border border-slate-100 hover:border-brand-200 hover:shadow-sm transition-all">
          <span class="text-3xl">{emoji}</span>
          <h3 class="mt-3 font-heading font-semibold text-slate-900">{title}</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA herramientas -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <div class="rounded-2xl bg-brand-50 border border-brand-100 p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-heading font-semibold text-brand-900">Herramientas para docentes</h2>
        <p class="mt-1 text-sm text-slate-600">Calculadora de baremos universitarios y recursos prácticos.</p>
      </div>
      <a href="/herramientas" class="flex-shrink-0 px-5 py-2.5 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors">
        Explorar herramientas
      </a>
    </div>
  </section>

</BaseLayout>
