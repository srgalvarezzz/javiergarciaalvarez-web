---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Inicio"
  description="Javier García-Álvarez, doctorando FPI en Educación Tecnológica en la Universidad de Extremadura. Investigación en Aprendizaje Basado en Juegos y tecnología educativa."
>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">
        Investigando el aprendizaje en un <span class="hero-title-mark">mundo tecnológico</span>
      </h1>
      <p class="hero-subtitle">
        Diseño y evalúo experiencias de aprendizaje basado en juegos en la universidad. Doctorando FPI en la Universidad de Extremadura.
      </p>
      <div class="hero-actions">
        <a href="/investigacion" class="btn-primary">Mi investigación</a>
        <a href="/sobre-mi" class="link-arrow">
          Sobre mí
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <img
        src="/avatar.jpg"
        alt="Javier García-Álvarez"
        width="480"
        height="480"
        loading="eager"
      />
    </div>
  </section>

  <!-- ── Divider ───────────────────────────────────────────────────── -->
  <div class="max-w-5xl mx-auto px-6">
    <hr class="border-slate-100" />
  </div>

  <!-- ── Áreas de investigación ────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-heading font-semibold text-slate-900 mb-10">Líneas de investigación</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {([
        {
          icon: 'Gamepad2' as const,
          title: 'Game-Based Learning',
          desc: 'Diseño y evaluación de experiencias de aprendizaje mediadas por el juego en contextos universitarios formales.',
        },
        {
          icon: 'Cog' as const,
          title: 'Game Mechanics',
          desc: 'Análisis de las mecánicas de juego como medio para evaluar el aprendizaje.',
        },
        {
          icon: 'BrainCircuit' as const,
          title: 'Inteligencia Artificial',
          desc: 'Participación como FPI en DIDACT.IA, proyecto que impulsa el pensamiento crítico mediado por la IA.',
        },
      ]).map(({ icon, title, desc }) => (
        <div class="p-6 rounded-xl border border-slate-100 hover:border-brand-200 hover:shadow-sm transition-all group">
          <span class="text-slate-400 group-hover:text-brand-500 transition-colors">
            <Icon name={icon} size={24} />
          </span>
          <h3 class="mt-3 font-heading font-semibold text-slate-900 group-hover:text-brand-700 transition-colors">{title}</h3>
          <p class="mt-2 text-sm text-slate-500 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── CTA herramientas ──────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-brand-100/60 border border-brand-100 p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <h2 class="text-xl font-heading font-semibold text-brand-900">Recursos abiertos</h2>
        <p class="text-sm text-slate-600">Datasets, calculadora de baremos y herramientas para investigadores.</p>
      </div>
      <a
        href="/recursos"
        class="flex-shrink-0 px-5 py-2.5 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors shadow-sm"
      >
        Explorar herramientas →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero (Fase 2) ── usa los tokens definidos en tokens.css ── */
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: center;
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .hero-title-mark {
    position: relative;
    display: inline-block;
  }

  .hero-title-mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 0.18em;
    background: var(--color-warm);
    z-index: -1;
    border-radius: 2px;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 32rem;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    transition: background var(--transition-fast), transform var(--transition-fast);
    text-decoration: none;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: white;
  }

  .btn-primary:active {
    transform: translateY(1px);
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    transition: gap var(--transition-base), color var(--transition-fast);
  }

  .link-arrow:hover {
    color: var(--color-accent);
    gap: 0.7rem;
  }

  .link-arrow span {
    transition: transform var(--transition-base);
  }

  .link-arrow:hover span {
    transform: translateX(2px);
  }

  .hero-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface-soft);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }
</style>
