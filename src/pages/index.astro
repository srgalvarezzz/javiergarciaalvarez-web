---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { persona } from '../utils/jsonld';
---

<BaseLayout
  title="Inicio"
  description="Javier García-Álvarez, doctorando FPI en la Universidad de Extremadura. Evidencia sobre IA generativa y pensamiento crítico, y sobre el aprendizaje en los juegos."
  jsonLd={persona}
>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">
        Tecnología educativa, con <span class="hero-title-mark">evidencia</span>
      </h1>
      <p class="hero-subtitle">
        Doctorando FPI en la Universidad de Extremadura. Trabajo en los dos sitios donde la tecnología promete más de lo que demuestra: la IA generativa en la universidad y los juegos en el aula. A veces escribo sobre lo que me incomoda.
      </p>
      <div class="hero-actions">
        <a href="/investigacion" class="btn-primary">Mi investigación</a>
        <a href="/sobre-mi" class="link-arrow">
          Sobre mí
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <img
        src="/avatar.jpg"
        alt="Javier García-Álvarez"
        width="480"
        height="480"
        loading="eager"
      />
    </div>
  </section>

  <!-- ── En qué investigo (Fase 3) ─────────────────────────────────── -->
  <section class="research-areas">
    <div class="research-areas-header">
      <p class="eyebrow">Áreas</p>
      <h2 class="section-title">En qué investigo</h2>
    </div>
    <div class="research-areas-grid">
      {/* Dos tarjetas, una por línea de trabajo, en el mismo orden en que las
          nombra el subtítulo del hero y en que las presenta /investigacion.
          Game Mechanics era una subdivisión de Game-Based Learning: separadas
          sumaban 2 contra 1 y hacían que la home leyera como si los juegos
          fueran la línea principal, que es justo lo que el marco común niega. */}
      {([
        {
          icon: 'BrainCircuit' as const,
          title: 'IA Generativa',
          desc: 'Síntesis de la evidencia sobre IA generativa y pensamiento crítico en educación superior, en el marco del proyecto DIDACT.IA.',
          enlace: { href: '/investigacion/didactia', label: 'El proyecto DIDACT.IA' },
        },
        {
          icon: 'Gamepad2' as const,
          title: 'Game-Based Learning',
          desc: 'Diseño y evaluación de experiencias de aprendizaje mediadas por el juego, y análisis de las mecánicas como indicador de lo que se aprende.',
          enlace: null,
        },
      ]).map(({ icon, title, desc, enlace }) => (
        <article class="research-card">
          <div class="research-card-icon" aria-hidden="true">
            <Icon name={icon} size={28} />
          </div>
          <h3 class="research-card-title">{title}</h3>
          <p class="research-card-body">{desc}</p>
          {enlace && (
            <a href={enlace.href} class="research-card-link">
              {enlace.label}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ── CTA recursos ──────────────────────────────────────────────── -->
  <section class="home-cta">
    <div class="home-cta-inner">
      <div class="home-cta-text">
        <h2 class="home-cta-title">Recursos abiertos</h2>
        <p class="home-cta-lead">Datasets, calculadora de baremos y herramientas para investigadores.</p>
      </div>
      <a href="/recursos" class="btn-primary">Explorar recursos →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero (Fase 2) ── usa los tokens definidos en tokens.css ── */
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    align-items: center;
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .hero-title-mark {
    position: relative;
    display: inline-block;
  }

  .hero-title-mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 0.18em;
    background: var(--color-warm);
    z-index: -1;
    border-radius: 2px;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
    max-width: 32rem;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    transition: background var(--transition-fast), transform var(--transition-fast);
    text-decoration: none;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: white;
  }

  .btn-primary:active {
    transform: translateY(1px);
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    text-decoration: none;
    transition: gap var(--transition-base), color var(--transition-fast);
  }

  .link-arrow:hover {
    color: var(--color-accent);
    gap: 0.7rem;
  }

  .link-arrow span {
    transition: transform var(--transition-base);
  }

  .link-arrow:hover span {
    transform: translateX(2px);
  }

  .hero-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface-soft);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* ── En qué investigo (Fase 3) ── usa tokens de tokens.css ── */
  .research-areas {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  .research-areas-header {
    margin-bottom: var(--space-block);
    max-width: 36rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
    font-weight: var(--weight-regular);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
  }

  .research-areas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .research-areas-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .research-card {
    background: var(--color-surface);
    border-left: 3px solid var(--color-warm);
    border-top: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .research-card-icon {
    color: var(--color-warm);
    width: 28px;
    height: 28px;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .research-card-icon :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 1.5;
  }

  .research-card-title {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
  }

  .research-card-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-ink-soft);
  }

  .research-card-link {
    margin-top: auto;
    padding-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-ink);
    text-decoration: none;
    align-self: flex-start;
    transition: gap var(--transition-base), color var(--transition-fast);
  }
  .research-card-link:hover { color: var(--color-accent); gap: 0.7rem; }

  /* ── CTA recursos ── */
  .home-cta {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 0 1.5rem calc(var(--space-section) * 0.8);
  }
  .home-cta-inner {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-warm);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: 2rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .home-cta-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-regular);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 0.35rem;
  }
  .home-cta-lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink-soft);
    max-width: 34rem;
  }

  /* ── Fade-in inicial (solo home, Fase 7) ── */
  .hero, .research-areas {
    animation: fadeInUp 0.5s ease-out both;
  }
  .research-areas { animation-delay: 0.1s; }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero, .research-areas { animation: none; }
  }
</style>
