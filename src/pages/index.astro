---
import BaseLayout from '../layouts/BaseLayout.astro';

const socialLinks = [
  { label: 'ORCID',          href: 'https://orcid.org/0009-0002-2876-2683',                                          icon: 'orcid'   },
  { label: 'Google Scholar', href: 'https://scholar.google.es/citations?user=mYf-JyQAAAAJ&hl=ca',                    icon: 'scholar' },
  { label: 'Twitter / X',    href: 'https://x.com/sralvarezzz_',                                                     icon: 'x'       },
  { label: 'LinkedIn',       href: 'https://www.linkedin.com/in/javier-garcía-álvarez-807854201/',                   icon: 'linkedin'},
];
---

<BaseLayout
  title="Inicio"
  description="Javier García-Álvarez, doctorando FPI en Educación Tecnológica en la Universidad de Extremadura. Investigación en Aprendizaje Basado en Juegos y tecnología educativa."
>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-16">
    <div class="flex flex-col md:flex-row items-center gap-14">

      <!-- Copy -->
      <div class="flex-1 space-y-6 order-2 md:order-1">
        <p class="text-sm font-medium text-brand-600 tracking-widest uppercase">
          Doctorando FPI · Universidad de Extremadura
        </p>

        <h1 class="text-4xl md:text-5xl font-heading font-semibold text-slate-900 leading-tight">
          Investigando el aprendizaje<br />
          en un <span class="text-brand-700">mundo tecnológico</span>
        </h1>

        <p class="text-lg text-slate-500 max-w-lg leading-relaxed">
          Estudio cómo la <strong class="font-medium text-slate-700">tecnología educativa</strong> puede transformar experiencias de aprendizaje.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="/investigacion" class="px-5 py-2.5 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors shadow-sm">
            Mi investigación
          </a>
          <a href="/sobre-mi" class="px-5 py-2.5 border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:border-brand-300 hover:text-brand-700 transition-colors">
            Sobre mí →
          </a>
        </div>

        <!-- Social links -->
        <div class="flex flex-wrap items-center gap-2 pt-1">
          {socialLinks.map(({ label, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 text-xs text-slate-500 hover:border-brand-300 hover:text-brand-700 transition-colors"
            >
              {icon === 'orcid' && (
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.516.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 3.872-2.862 3.872-3.722 0-2.016-1.284-3.722-3.9-3.722h-2.269z"/></svg>
              )}
              {icon === 'scholar' && (
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 10a8 8 0 0 1 7.162 3.44L24 9.5z"/></svg>
              )}
              {icon === 'x' && (
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              )}
              {icon === 'linkedin' && (
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              )}
              {label}
            </a>
          ))}
        </div>
      </div>

      <!-- Avatar -->
      <div class="order-1 md:order-2 flex-shrink-0">
        <div class="relative w-44 h-44 md:w-52 md:h-52 rounded-full overflow-hidden ring-4 ring-brand-100 shadow-lg">
          <img
            src="/avatar.jpg"
            alt="Javier García-Álvarez"
            class="absolute w-full h-auto left-0"
            style="top: -30%;"
            loading="eager"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- ── Divider ───────────────────────────────────────────────────── -->
  <div class="max-w-5xl mx-auto px-6">
    <hr class="border-slate-100" />
  </div>

  <!-- ── Áreas de investigación ────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-heading font-semibold text-slate-900 mb-10">Líneas de investigación</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {[
        {
          emoji: '🎮',
          title: 'Game-Based Learning',
          desc: 'Diseño y evaluación de experiencias de aprendizaje mediadas por el juego en contextos universitarios formales.',
        },
        {
          emoji: '⚙️',
          title: 'Game Mechanics',
          desc: 'Análisis de las mecánicas de juego como medio para evaluar el aprendizaje.',
        },
        {
          emoji: '🤖',
          title: 'Inteligencia Artificial',
          desc: 'Participación como FPI en DIDACT.IA, proyecto que impulsa el pensamiento crítico mediado por la IA.',
        },
      ].map(({ emoji, title, desc }) => (
        <div class="p-6 rounded-xl border border-slate-100 hover:border-brand-200 hover:shadow-sm transition-all group">
          <span class="text-2xl">{emoji}</span>
          <h3 class="mt-3 font-heading font-semibold text-slate-900 group-hover:text-brand-700 transition-colors">{title}</h3>
          <p class="mt-2 text-sm text-slate-500 leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── CTA herramientas ──────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-brand-100/60 border border-brand-100 p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <h2 class="text-xl font-heading font-semibold text-brand-900">Recursos abiertos</h2>
        <p class="text-sm text-slate-600">Datasets, calculadora de baremos y herramientas para investigadores.</p>
      </div>
      <a
        href="/recursos"
        class="flex-shrink-0 px-5 py-2.5 bg-brand-700 text-white rounded-lg text-sm font-medium hover:bg-brand-600 transition-colors shadow-sm"
      >
        Explorar herramientas →
      </a>
    </div>
  </section>

</BaseLayout>
