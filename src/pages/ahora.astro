---
import BaseLayout from '../layouts/BaseLayout.astro';
import VoiceMarker from '../components/VoiceMarker.astro';

const lastUpdated = '2026-05-29'; // fecha de última actualización manual
const formattedDate = new Date(lastUpdated).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title="Ahora" description="Qué estoy haciendo en este momento de mi vida investigadora.">
  <div class="now-page">
    <header class="now-header">
      <p class="eyebrow">Ahora · <time datetime={lastUpdated}>{formattedDate}</time></p>
      <h1 class="now-headline">En qué ando estos meses.</h1>
      <p class="now-lead">
        Esta es una <a href="https://nownownow.com" target="_blank" rel="noopener noreferrer">now page</a>:
        una foto honesta de en qué centro la atención ahora mismo. Se actualiza cuando algo cambia,
        no antes.
      </p>
    </header>

    <section class="now-section">
      <h2 class="now-section-title">Investigación</h2>
      <ul class="now-list">
        <li>
          Avanzando la <strong>Revisión Sistemática de Literatura</strong> sobre IA y pensamiento crítico
          en Educación Superior. Fase de extracción terminada, redactando los resultados.
        </li>
        <li>
          Participando en <strong>DIDACT.IA</strong>, en la fase de implementación y validación.
        </li>
      </ul>
    </section>

    <section class="now-section">
      <h2 class="now-section-title">Construyendo</h2>
      <ul class="now-list">
        <li>Esta web. Después de meses pensándola, está en su versión 1.</li>
        <li>
          <strong>Foco</strong>, una extensión de navegador para bloquear apps y dominios y concentrarse.
          En fase temprana.
        </li>
      </ul>
    </section>

    <section class="now-section">
      <h2 class="now-section-title">Leyendo</h2>
      <ul class="now-list">
        <li>
          Releyendo a Arnab et al. (2015) sobre mecánicas de juego y aprendizaje. Anclaje del marco teórico.
        </li>
      </ul>
    </section>

    <section class="now-section">
      <h2 class="now-section-title">Aprendiendo</h2>
      <ul class="now-list">
        <li>
          A delegar el trabajo operativo en herramientas de IA, reservándome a mí la validación y el criterio.
        </li>
      </ul>
    </section>

    <footer class="now-footer">
      <VoiceMarker size={24} />
      <p>
        Inspirado en <a href="https://sive.rs/now" target="_blank" rel="noopener noreferrer">Derek Sivers</a>
        y el <a href="https://nownownow.com" target="_blank" rel="noopener noreferrer">movimiento /now</a>.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .now-page {
    max-width: 38rem;
    margin: 0 auto;
    padding: var(--space-section) 1.5rem;
  }

  .now-header { margin-bottom: 3.5rem; }

  .now-header .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
    margin-bottom: 1.25rem;
  }

  .now-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    font-weight: var(--weight-regular);
    margin-bottom: 1.5rem;
  }

  .now-lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }
  .now-lead a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-warm);
    text-underline-offset: 3px;
  }

  .now-section { margin-bottom: 2.5rem; }

  .now-section-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-warm);
    font-weight: var(--weight-medium);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .now-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .now-list li {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-ink);
    padding-left: 1.25rem;
    position: relative;
  }

  .now-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    top: -0.1em;
    color: var(--color-warm);
    font-size: 1.5em;
    font-weight: bold;
  }

  .now-list strong { font-weight: var(--weight-semibold); color: var(--color-ink); }

  .now-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .now-footer p { margin: 0; }
  .now-footer a {
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }
  .now-footer a:hover { color: var(--color-ink); }
</style>
